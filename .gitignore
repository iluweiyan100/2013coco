# 忽略 node_modules
node_modules/
cloudfunctions/*/node_modules/

# 忽略编译产物
*.wcc
*.wxmlc
.tmproj
*.sublime-project
*.sublime-workspace

# 忽略系统文件
.DS_Store
Thumbs.db
.idea/
*.iml

# 忽略日志文件
*.log
logs/

# 忽略临时文件
*.tmp
*.swp
*.bak

# 忽略 VSCode 特定文件
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# 忽略商户证书和密钥（敏感信息，通过云开发控制台环境变量管理）
*_cert/
*.pem
*.p12
*.p8
apiclient_*
!cloudfunctions/*/package.json

# 忽略图片文件
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.bmp
*.ico
*.tiff

# 忽略文字文件
*.txt
*.md

# 忽略字体文件
仓耳舒圆体 W03.TTF