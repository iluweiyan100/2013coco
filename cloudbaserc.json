{
  "envId": "cloud3-d2gbcvyqkbc0fbf94",
  "version": "2.0.0",
  "root": ".",
  "projectName": "微信点单小程序",
  "framework": {
    "name": "wechat-miniprogram"
  },
  "functions": [
    {
      "name": "initDB",
      "timeout": 10,
      "runtime": "Nodejs18.15"
    },
    {
      "name": "sendSubscribeMessage",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "envVariables": {
        "WX_APP_SECRET": "__SET_IN_CLOUD_CONSOLE__",
        "MINIPROGRAM_STATE": "developer"
      }
    },
    {
      "name": "generateTableQRCode",
      "timeout": 15,
      "runtime": "Nodejs18.15",
      "envVariables": {
        "WX_APP_SECRET": "__SET_IN_CLOUD_CONSOLE__",
        "MINIPROGRAM_STATE": "formal"
      }
    },
    {
      "name": "createPayment",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "envVariables": {
        "WX_MCH_PRIVATE_KEY": "__SET_IN_CLOUD_CONSOLE__",
        "WX_MCH_SERIAL_NO": "__SET_IN_CLOUD_CONSOLE__"
      }
    },
    {
      "name": "refundPayment",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "envVariables": {
        "WX_MCH_PRIVATE_KEY": "__SET_IN_CLOUD_CONSOLE__",
        "WX_MCH_SERIAL_NO": "__SET_IN_CLOUD_CONSOLE__",
        "WX_MCH_API_KEY": "__SET_IN_CLOUD_CONSOLE__"
      }
    },
    {
      "name": "createPaymentCallback",
      "timeout": 15,
      "runtime": "Nodejs16.13",
      "envVariables": {
        "WX_MCH_API_KEY": "__SET_IN_CLOUD_CONSOLE__"
      }
    }
  ]
}
