/* components/staff-order-sidebar/staff-order-sidebar.wxss */
/* 固定 px 尺寸，横竖屏切换不变形 */

.sos-root {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 380px;
  background: #ffffff;
  box-shadow: 6px 0 24px rgba(0, 0, 0, 0.18);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 头部 */
.sos-header {
  display: flex;
  align-items: center;
  height: 48px;
  padding: 0 14px;
  border-bottom: 1px solid #EFE6DC;
  flex-shrink: 0;
}
.sos-title { font-size: 16px; font-weight: bold; color: #3B1F0F; }
.sos-order-type-toggle {
  margin-left: 10px;
  display: flex;
  background: #F6F1EA;
  border-radius: 14px;
  padding: 2px;
}
.sos-type-opt {
  padding: 3px 12px;
  font-size: 12px;
  color: #5B3A29;
  border-radius: 12px;
}
.sos-type-opt-active {
  background: #A3212D;
  color: #fff;
}
.sos-close {
  margin-left: auto;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sos-close-x { color: #999; font-size: 16px; }

/* 分类 */
.sos-cats {
  flex-shrink: 0;
  white-space: nowrap;
  height: 45px;
  padding: 8px 12px;
  border-bottom: 1px solid #F2EEE8;
  box-sizing: border-box;
}
.sos-cat {
  display: inline-block;
  padding: 5px 12px;
  margin-right: 8px;
  font-size: 13px;
  line-height: 18px;
  color: #5B3A29;
  background: #F6F1EA;
  border-radius: 14px;
}
.sos-cat-active { background: #A3212D; color: #fff; }

/* 商品列表 */
.sos-products {
  flex: 1;
  overflow: hidden;
  box-sizing: border-box;
}
.sos-empty { padding: 24px; text-align: center; color: #999; font-size: 13px; }
.sos-product {
  display: flex;
  align-items: center;
  padding: 10px 12px;
  border-bottom: 1px solid #F5F1EC;
}
.sos-product-hidden { display: none; }
.sos-product-img {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  flex-shrink: 0;
  background: #F2EEE8;
}
.sos-product-info { flex: 1; margin: 0 10px; min-width: 0; }
.sos-product-name { display: block; font-size: 14px; color: #3B1F0F; font-weight: 500; }
.sos-product-tags { display: flex; margin-top: 2px; }
.sos-tag {
  font-size: 10px;
  color: #A3212D;
  background: rgba(163, 33, 45, 0.08);
  padding: 1px 6px;
  border-radius: 8px;
  margin-right: 4px;
}
.sos-product-price { display: block; font-size: 13px; color: #A3212D; margin-top: 2px; }
.sos-qty-control { display: flex; align-items: center; flex-shrink: 0; }
.sos-plus, .sos-minus {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #fff;
  background: #A3212D;
}
.sos-minus { background: #fff; color: #A3212D; border: 1px solid #A3212D; }
.sos-qty-num { min-width: 24px; text-align: center; font-size: 13px; color: #3B1F0F; }

/* 购物车 + 结算 */
.sos-cart { flex-shrink: 0; border-top: 1px solid #EFE6DC; background: #FBF8F4; }
/* 购物车清单高度由 _refreshCart 动态设置（见 WXML inline style），封顶 160px 后滚动 */
.sos-cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 14px;
}
.sos-cart-item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.sos-cart-item-name-row { display: flex; align-items: center; }
.sos-cart-item-name { font-size: 13px; color: #3B1F0F; }
.sos-cart-item-type {
  margin-left: 6px;
  font-size: 10px;
  padding: 1px 5px;
  border-radius: 6px;
  color: #A3212D;
  background: rgba(163, 33, 45, 0.08);
}
.sos-cart-item-type-takeaway { color: #0E7490; background: rgba(14, 116, 144, 0.10); }
.sos-cart-item-spec { font-size: 11px; color: #999; margin-top: 1px; }
.sos-cart-item-price { font-size: 13px; color: #A3212D; margin-left: 10px; }

.sos-footer { padding: 8px 14px calc(8px + env(safe-area-inset-bottom)); }
.sos-remark {
  width: 100%;
  height: 32px;
  background: #fff;
  border: 1px solid #EFE6DC;
  border-radius: 6px;
  padding: 0 10px;
  font-size: 13px;
  box-sizing: border-box;
  margin-bottom: 8px;
}
.sos-remark-ph { color: #bbb; }
.sos-footer-row { display: flex; align-items: center; justify-content: space-between; }
.sos-total { font-size: 15px; font-weight: bold; color: #A3212D; }
.sos-submit {
  background: #A3212D;
  padding: 9px 18px;
  border-radius: 20px;
}
.sos-submit-disabled { opacity: 0.5; }
.sos-submit-text { color: #fff; font-size: 14px; }

/* 规格弹窗（全屏覆盖，位于侧栏之上） */
.sos-spec-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2100;
}
.sos-spec-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  z-index: 2101;
  padding: 16px;
  max-height: 80vh;
  overflow-y: auto;
  box-sizing: border-box;
}
.sos-spec-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.sos-spec-title { font-size: 17px; font-weight: bold; color: #3B1F0F; }
.sos-spec-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 16px;
}
.sos-spec-subtitle { display: block; font-size: 13px; color: #5B3A29; margin: 10px 0 8px; }
.sos-spec-options { display: flex; flex-wrap: wrap; gap: 8px; }
.sos-spec-option {
  padding: 7px 14px;
  border-radius: 16px;
  background: #F6F1EA;
  font-size: 13px;
  color: #5B3A29;
}
.sos-spec-option-active { background: #A3212D; color: #fff; }
.sos-spec-price { font-size: 12px; }
.sos-flavor-list { display: flex; flex-wrap: wrap; gap: 8px; }
.sos-flavor-chip {
  position: relative;
  padding: 7px 14px;
  border-radius: 16px;
  background: #F6F1EA;
  font-size: 13px;
  color: #5B3A29;
}
.sos-flavor-chip-active { background: #A3212D; }
.sos-flavor-text { color: #5B3A29; }
.sos-flavor-text-active { color: #fff; }
.sos-flavor-minus {
  position: absolute;
  top: -6px;
  left: -6px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid #A3212D;
  color: #A3212D;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  line-height: 1;
}
.sos-flavor-qty { font-size: 12px; }
.sos-spec-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14px;
}
.sos-spec-total-label { font-size: 14px; color: #3B1F0F; }
.sos-spec-total-price { font-size: 18px; font-weight: bold; color: #A3212D; }
.sos-spec-confirm {
  margin-top: 12px;
  background: #A3212D;
  border-radius: 22px;
  padding: 12px 0;
  text-align: center;
}
.sos-spec-confirm-text { color: #fff; font-size: 15px; }
