<!--admin.wxml-->
<page-meta page-style="{{_prodDragActive ? 'overflow: hidden;' : ''}}"></page-meta>

<!-- 顶部自定义导航栏 -->
<navigation-bar title="管理后台" back="{{true}}" color="#5B3A29" background="#FFFFFF"></navigation-bar>

<!-- 主内容滚动区 -->
<scroll-view class="admin-scroll" scroll-y="{{!_prodDragActive}}" scroll-top="{{_lockedScrollTop}}" bindscroll="onAdminScroll">
  <view class="admin-body">

    <!-- Tab 切换栏 -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'stats' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="stats">
        <text class="tab-text {{activeTab === 'stats' ? 'tab-text-active' : ''}}">数据统计</text>
      </view>
      <view class="tab-item {{activeTab === 'products' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="products">
        <text class="tab-text {{activeTab === 'products' ? 'tab-text-active' : ''}}">商品管理</text>
      </view>
      <view class="tab-item {{activeTab === 'orders' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="orders">
        <text class="tab-text {{activeTab === 'orders' ? 'tab-text-active' : ''}}">订单管理</text>
      </view>
      <view class="tab-item {{activeTab === 'home' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="home">
        <text class="tab-text {{activeTab === 'home' ? 'tab-text-active' : ''}}">首页内容</text>
      </view>
    </view>

    <!-- ========== 数据统计 Tab ========== -->
    <view wx:if="{{activeTab === 'stats'}}" class="tab-content">

      <!-- 统计周期选择 -->
      <view class="stats-period-bar">
        <view class="period-btn {{statsPeriod === 'day' ? 'period-active' : ''}}" bindtap="onStatsPeriod" data-period="day">
          <text class="period-text {{statsPeriod === 'day' ? 'period-text-active' : ''}}">日</text>
        </view>
        <view class="period-btn {{statsPeriod === 'week' ? 'period-active' : ''}}" bindtap="onStatsPeriod" data-period="week">
          <text class="period-text {{statsPeriod === 'week' ? 'period-text-active' : ''}}">周</text>
        </view>
        <view class="period-btn {{statsPeriod === 'month' ? 'period-active' : ''}}" bindtap="onStatsPeriod" data-period="month">
          <text class="period-text {{statsPeriod === 'month' ? 'period-text-active' : ''}}">月</text>
        </view>
      </view>

      <!-- 销售额 -->
      <view class="stat-card">
        <view class="stat-card-header">
          <view class="stat-icon-wrap stat-icon-red">
            <image src="/assets/CodeBubbyAssets/4_630/2.svg" class="stat-icon-img" mode="aspectFit"></image>
          </view>
          <text class="stat-card-label">{{statsPeriod === 'day' ? '今日' : statsPeriod === 'week' ? '本周' : '本月'}}销售额</text>
        </view>
        <text class="stat-card-value stat-value-red">¥{{todaySales}}</text>
      </view>

      <!-- 订单量 -->
      <view class="stat-card">
        <view class="stat-card-header">
          <view class="stat-icon-wrap stat-icon-gold">
            <image src="/assets/CodeBubbyAssets/4_630/3.svg" class="stat-icon-img" mode="aspectFit"></image>
          </view>
          <text class="stat-card-label">订单量</text>
        </view>
        <text class="stat-card-value stat-value-gold">{{orderCount}}</text>
      </view>

      <!-- 客单价 -->
      <view class="stat-card">
        <view class="stat-card-header">
          <view class="stat-icon-wrap stat-icon-brown">
            <image src="/assets/CodeBubbyAssets/4_630/4.svg" class="stat-icon-img" mode="aspectFit"></image>
          </view>
          <text class="stat-card-label">客单价</text>
        </view>
        <text class="stat-card-value stat-value-brown">¥{{avgOrderValue}}</text>
      </view>

      <!-- 商品销售排行 -->
      <view class="ranking-card">
        <text class="ranking-title">商品销售排行</text>

        <!-- 冰淇淋大类（固定置顶，可展开口味球数） -->
        <view class="ranking-row icecream-rank-row" bindtap="onToggleIcecreamDetail">
          <view class="ranking-left">
            <view class="rank-badge rank-badge-icecream"><text class="rank-num">🍦</text></view>
            <view class="icecream-title-wrap">
              <text class="rank-name">冰淇淋</text>
              <text class="rank-sales">杯 {{icecreamSummary.cups}} · 球 {{icecreamSummary.scoops}}</text>
            </view>
          </view>
          <view class="ranking-right">
            <text class="rank-revenue">¥{{icecreamSummary.revenue}}</text>
            <text class="icecream-arrow {{icecreamExpanded ? 'icecream-arrow-open' : ''}}">▾</text>
          </view>
        </view>

        <!-- 口味球数下拉 -->
        <view wx:if="{{icecreamExpanded}}" class="flavor-breakdown">
          <view wx:for="{{icecreamSummary.flavors}}" wx:key="name" class="flavor-line">
            <text class="flavor-name">{{item.name}}</text>
            <text class="flavor-scoops">{{item.scoops}} 球</text>
          </view>
        </view>

        <view class="ranking-list">
          <view
            wx:for="{{productRanking}}"
            wx:key="rank"
            class="ranking-row {{index < productRanking.length - 1 ? 'ranking-row-border' : ''}}"
          >
            <view class="ranking-left">
              <view class="rank-badge rank-badge-{{item.rank <= 3 ? item.rank : 'other'}}">
                <text class="rank-num">{{item.rank}}</text>
              </view>
              <text class="rank-name">{{item.name}}</text>
            </view>
            <view class="ranking-right">
              <text class="rank-sales">销量 {{item.sales}}</text>
              <text class="rank-revenue">¥{{item.revenue}}</text>
            </view>
          </view>
        </view>
      </view>

    </view>

    <!-- ========== 商品管理 Tab ========== -->
    <view wx:if="{{activeTab === 'products'}}" class="tab-content">

      <!-- 类别筛选器 -->
      <view class="category-filter">
        <view
          wx:for="{{categoryFilters}}"
          wx:key="value"
          class="category-btn {{activeCategoryFilter === item.value ? 'category-btn-active' : ''}}"
          bindtap="onCategoryFilter"
          data-value="{{item.value}}"
        >
          <text class="category-btn-text {{activeCategoryFilter === item.value ? 'category-btn-text-active' : ''}}">{{item.label}} ({{item.count}})</text>
        </view>
      </view>

      <!-- 商品状态筛选 -->
      <view class="category-filter status-filter">
        <view
          wx:for="{{statusFilters}}"
          wx:key="value"
          class="category-btn {{activeStatusFilter === item.value ? 'category-btn-active' : ''}}"
          bindtap="onStatusFilter"
          data-value="{{item.value}}"
        >
          <text class="category-btn-text {{activeStatusFilter === item.value ? 'category-btn-text-active' : ''}}">{{item.label}} ({{item.count}})</text>
        </view>
      </view>

      <!-- 新增商品按钮 + 刷新 -->
      <view class="add-product-row">
        <view class="add-product-btn" bindtap="onAddProduct">
          <image src="/assets/CodeBubbyAssets/4_745/2.svg" class="add-product-icon" mode="aspectFit"></image>
          <text class="add-product-text">新增商品</text>
        </view>
        <view class="refresh-btn" bindtap="onRefreshProducts">
          <text class="refresh-btn-text">刷新</text>
        </view>
      </view>

      <!-- 加载中 -->
      <view wx:if="{{productsLoading}}" class="products-loading">
        <text class="products-loading-text">加载中...</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{filteredProducts.length === 0}}" class="products-empty">
        <text class="products-empty-text">暂无商品，点击「新增商品」添加</text>
      </view>

      <!-- 商品列表 -->
      <view wx:else class="product-list">
        <view
          wx:for="{{filteredProducts}}"
          wx:key="_id"
          class="product-card {{_prodDragTarget === index && _prodDragActive ? 'product-card-dragging' : ''}}"
          style="{{_prodDragActive && _prodDragIdx === index ? 'transform: translateY(' + _prodDragOffY + 'px); z-index: 10; opacity: 0.9;' : ''}}"
          bindtouchstart="onProductDragStart"
          bindtouchmove="onProductDragMove"
          bindtouchend="onProductDragEnd"
          data-index="{{index}}"
        >
          <view class="product-card-left">
            <image src="{{item.imageURL || item.image || ''}}" class="product-img" mode="aspectFill"></image>
            <view class="product-info">
              <text class="product-name">{{item.name}}</text>
              <!-- 咖啡类商品：烘焙度和处理法标签 -->
              <view class="coffee-info-tags" wx:if="{{item.category === 'coffee' && (item.roastLevel || item.processingMethod)}}">
                <text wx:if="{{item.roastLevel}}" class="coffee-tag roast-tag" catchtap="onQuickEditRoast" data-id="{{item._id}}" data-roast="{{item.roastLevel}}">{{item.roastLevel}}</text>
                <text wx:if="{{item.processingMethod}}" class="coffee-tag process-tag" catchtap="onQuickEditProcessing" data-id="{{item._id}}" data-processing="{{item.processingMethod}}">{{item.processingMethod}}</text>
              </view>
              <view class="product-meta">
                <text class="product-price">¥{{item.price}}</text>
                <text class="product-sales">销量 {{item.sales || 0}}</text>
                <view class="product-tag">
                  <text class="product-tag-text">{{item.categoryLabel}}</text>
                </view>
                <view class="product-status-tag product-status-{{item.saleStatus}}" catchtap="onQuickEditStatus" data-id="{{item._id}}" data-status="{{item.saleStatus}}">
                  <text class="product-status-text">{{item.saleStatus === 'on' ? '上架' : '下架'}}</text>
                </view>
              </view>
            </view>
          </view>
          <view class="product-actions">
            <view class="product-action-btn" catchtap="onEditProduct" data-id="{{item._id}}">
              <image src="/assets/CodeBubbyAssets/4_745/4.svg" class="product-action-icon" mode="aspectFit"></image>
            </view>
            <view class="product-action-btn" catchtap="onDeleteProduct" data-id="{{item._id}}">
              <image src="/assets/CodeBubbyAssets/4_745/5.svg" class="product-action-icon" mode="aspectFit"></image>
            </view>
          </view>
        </view>
      </view>

    </view>

    <!-- ========== 订单管理 Tab ========== -->
    <view wx:if="{{activeTab === 'orders'}}" class="tab-content">

      <!-- 订单状态筛选器 -->
      <scroll-view scroll-x class="order-filter">
        <view
          wx:for="{{orderFilters}}"
          wx:key="value"
          class="order-filter-btn {{activeOrderFilter === item.value ? 'order-filter-btn-active' : ''}}"
          bindtap="onOrderFilter"
          data-value="{{item.value}}"
        >
          <text class="order-filter-text {{activeOrderFilter === item.value ? 'order-filter-text-active' : ''}}">{{item.label}} ({{item.count}})</text>
        </view>
      </scroll-view>

      <!-- 订单列表 -->
      <view class="order-list">
        <view wx:for="{{filteredOrders}}" wx:key="id" class="order-card">

          <!-- 订单头部：状态标签 + 取餐号 + 用餐方式 + 时间 + 退款按钮 -->
          <view class="order-header">
            <view class="order-header-left">
              <view class="order-status-tag" bindtap="updateOrderStatus" data-id="{{item._id}}" data-status="{{item.status === 'making' ? 'ready' : item.status === 'ready' ? 'done' : 'making'}}">
                <image src="/assets/CodeBubbyAssets/4_1696/2.svg" class="order-status-icon" mode="aspectFit" wx:if="{{item.status === 'making'}}"></image>
                <image src="/assets/CodeBubbyAssets/4_1696/3.svg" class="order-status-icon" mode="aspectFit" wx:if="{{item.status === 'ready'}}"></image>
                <text class="order-status-text">{{item.status === 'pending' ? '待支付' : item.status === 'making' ? '制作中' : item.status === 'ready' ? '待取餐' : item.status === 'refunded' ? '已退款' : '已完成'}}</text>
              </view>
              <view class="order-pickup-no">
                <text class="order-pickup-label">取餐号: </text>
                <text class="order-pickup-num">{{item.pickupNo}}</text>
              </view>
              <view class="order-type-tag">
                <text class="order-type-text">{{item.type === 'dine' ? '堂食' : '外带'}}</text>
              </view>
            </view>
            <view class="order-refund-btn {{item.status === 'refunded' ? 'order-refund-disabled' : ''}}" bindtap="onOpenRefund" data-id="{{item._id}}">
              <text class="order-refund-text">{{item.status === 'refunded' ? '已退款' : '退款'}}</text>
            </view>
          </view>

          <!-- 用户 + 时间 -->
          <view class="order-user-row">
            <text class="order-user-text">用户: {{item.userName}}</text>
            <text class="order-time-text">{{item.time}}</text>
          </view>

          <!-- 商品明细 -->
          <view class="order-items-divider"></view>
          <view class="order-items">
            <view wx:for="{{item.items}}" wx:key="index" wx:for-item="good" class="order-item-row">
              <view class="order-item-left">
                <view class="order-item-title">
                  <text class="order-item-name">{{good.name}}</text>
                  <text class="order-item-temp" wx:if="{{good.temp}}">{{good.temp}}</text>
                  <text class="order-item-qty">x{{good.qty}}</text>
                </view>
                <!-- 拼球：口味/加料分行显示 -->
                <view wx:if="{{good.flavors.length > 0}}" class="scoop-lines">
                  <view wx:for="{{good.flavors}}" wx:for-item="flavor" wx:key="name" class="scoop-line">
                    <text class="scoop-name">{{flavor.name}}</text>
                    <text class="scoop-qty">×{{flavor.qty}}</text>
                  </view>
                  <view wx:for="{{good.toppings}}" wx:for-item="topping" wx:key="*this" class="scoop-line">
                    <text class="scoop-topping">{{topping}}</text>
                  </view>
                </view>
                <text wx:elif="{{good.spec}}" class="order-item-temp">{{good.spec}}</text>
              </view>
              <text wx:if="{{good.refunded}}" class="order-item-refunded">已退款</text>
              <text wx:else class="order-item-price">¥{{good.price}}</text>
            </view>
          </view>

          <!-- 备注 -->
          <view wx:if="{{item.remark}}" class="order-remark">
            <text class="order-remark-label">备注: </text>
            <text class="order-remark-text">{{item.remark}}</text>
          </view>

          <!-- 合计 -->
          <view class="order-total-divider"></view>
          <view class="order-total-row">
            <text class="order-total-label">合计</text>
            <view class="order-total-amount">
              <text wx:if="{{item.refundedAmount > 0}}" class="order-total-refunded">已退 ¥{{item.refundedAmount}}</text>
              <text class="order-total-value">¥{{item.finalAmount}}</text>
            </view>
          </view>

        </view>
      </view>

    </view>

    <!-- ========== 首页内容 Tab ========== -->
    <view wx:if="{{activeTab === 'home'}}" class="tab-content">

      <!-- 首页商品展示设置 -->
      <view class="home-settings-card home-hero-card">
        <text class="home-settings-title">首页商品展示</text>
        <text class="home-hero-hint">选择要在首页重点展示的商品，点击图片可替换</text>

        <view class="featured-list">
          <view
            wx:for="{{featuredItems}}"
            wx:key="productId"
            class="featured-item {{_dragTargetIndex === index && _dragActive ? 'featured-dragging' : ''}}"
            style="{{_dragActive && _draggingIndex === index ? 'transform: translateY(' + _dragOffsetY + 'px); z-index: 10; opacity: 0.85;' : ''}}"
            data-index="{{index}}"
          >
            <!-- 拖拽按钮：长按2秒启动拖拽 -->
            <view
              class="featured-drag-handle {{_dragTargetIndex === index && !_dragActive ? 'featured-drag-activating' : ''}}"
              catchtouchstart="onFeaturedDragStart"
              catchtouchmove="onFeaturedDragMove"
              catchtouchend="onFeaturedDragEnd"
              data-index="{{index}}"
            >
              <text class="featured-drag-icon">⠿</text>
              <text class="featured-drag-label">拖拽排序</text>
            </view>
            <image
              src="{{item.imageURL}}"
              class="featured-img"
              mode="aspectFill"
              bindtap="onReplaceFeaturedImage"
              data-index="{{index}}"
            ></image>
            <view class="featured-info-row">
              <text class="featured-name-text">{{item.name || '加载中...'}}</text>
              <view class="hero-img-delete" catchtap="onDeleteFeaturedItem" data-index="{{index}}">
                <text class="hero-img-delete-text">✕</text>
              </view>
            </view>
          </view>

          <view class="featured-add" bindtap="onAddFeaturedProduct">
            <text class="hero-img-add-icon">＋</text>
            <text class="hero-img-add-text">添加商品</text>
          </view>
        </view>

        <view class="home-form-actions">
          <view class="home-action-save" bindtap="onSaveFeaturedProducts">
            <text class="home-action-save-text">保存</text>
          </view>
          <view class="home-action-cancel" bindtap="onCancelFeaturedProducts">
            <text class="home-action-cancel-text">取消</text>
          </view>
        </view>
      </view>

      <!-- 英雄区轮播图设置 -->
      <view class="home-settings-card home-hero-card">
        <text class="home-settings-title">英雄区轮播图</text>
        <text class="home-hero-hint">最多可添加 3 张图片，点击图片可替换</text>

        <!-- 图片列表 -->
        <view class="hero-img-list">
          <view
            wx:for="{{heroImages}}"
            wx:key="index"
            class="hero-img-item"
          >
            <image
              src="{{item}}"
              class="hero-img-thumb"
              mode="aspectFill"
              bindtap="onReplaceHeroImage"
              data-index="{{index}}"
            ></image>
            <view class="hero-img-delete" bindtap="onDeleteHeroImage" data-index="{{index}}">
              <text class="hero-img-delete-text">✕</text>
            </view>
          </view>

          <!-- 添加按钮（不超过 3 张时显示） -->
          <view wx:if="{{heroImages.length < 3}}" class="hero-img-add" bindtap="onAddHeroImage">
            <text class="hero-img-add-icon">＋</text>
            <text class="hero-img-add-text">添加图片</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="home-form-actions">
          <view class="home-action-save" bindtap="onSaveHeroImages">
            <text class="home-action-save-text">保存</text>
          </view>
          <view class="home-action-cancel" bindtap="onCancelHeroImages">
            <text class="home-action-cancel-text">取消</text>
          </view>
        </view>
      </view>

      <!-- Wi-Fi 设置 -->
      <view class="home-settings-card">
        <text class="home-settings-title">Wi-Fi设置</text>
        <view class="home-form-body">
          <!-- Wi-Fi名称 -->
          <view class="home-form-item">
            <text class="home-form-label">Wi-Fi名称</text>
            <input
              class="home-form-input"
              value="{{wifiName}}"
              placeholder="请输入Wi-Fi名称"
              bindinput="onInputWifiName"
            />
          </view>
          <!-- Wi-Fi密码 -->
          <view class="home-form-item">
            <text class="home-form-label">Wi-Fi密码</text>
            <input
              class="home-form-input"
              value="{{wifiPassword}}"
              placeholder="请输入Wi-Fi密码"
              bindinput="onInputWifiPassword"
            />
          </view>
          <!-- 操作按钮 -->
          <view class="home-form-actions">
            <view class="home-action-save" bindtap="onSaveHomeSettings">
              <text class="home-action-save-text">保存</text>
            </view>
            <view class="home-action-cancel" bindtap="onCancelHomeSettings">
              <text class="home-action-cancel-text">取消</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 营业时间设置 -->
      <view class="home-settings-card">
        <view class="home-settings-title-row">
          <text class="home-settings-title">营业时间</text>
          <view class="staff-close-btn {{shopClosed ? 'close-active' : ''}}" bindtap="onToggleClosed">
            <text class="staff-close-text">{{shopClosed ? '打烊' : '营业'}}</text>
          </view>
        </view>
        <view class="home-form-body">
          <view class="home-form-item">
            <text class="home-form-label">营业时间</text>
            <picker mode="time" value="{{openingTime}}" bindchange="onPickerOpeningTime">
              <view class="pm-picker-inner"><text class="pm-picker-text">{{openingTime || '选择营业时间'}}</text><text class="pm-picker-arrow">▾</text></view>
            </picker>
          </view>
          <view class="home-form-item">
            <text class="home-form-label">打烊时间</text>
            <picker mode="time" value="{{closingTime}}" bindchange="onPickerClosingTime">
              <view class="pm-picker-inner"><text class="pm-picker-text">{{closingTime || '选择打烊时间'}}</text><text class="pm-picker-arrow">▾</text></view>
            </picker>
          </view>
          <view class="home-form-item">
            <text class="home-form-label">打烊提示标题</text>
            <input class="home-form-input" value="{{closedTitle}}" placeholder="店铺已打烊" bindinput="onInputClosedTitle"/>
          </view>
          <view class="home-form-item">
            <text class="home-form-label">打烊提示内容</text>
            <input class="home-form-input" value="{{closedMessage}}" placeholder="明天 08:00 开始营业" bindinput="onInputClosedMessage"/>
          </view>
          <view class="home-form-actions">
            <view class="home-action-save" bindtap="onSaveBusinessHours">
              <text class="home-action-save-text">保存</text>
            </view>
            <view class="home-action-cancel" bindtap="onCancelBusinessHours">
              <text class="home-action-cancel-text">取消</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 分享链接设置 -->
      <view class="home-settings-card">
        <text class="home-settings-title">分享链接编辑</text>
        <view class="home-form-body">
          <!-- 分享给朋友标题 -->
          <view class="home-form-item">
            <text class="home-form-label">分享给朋友标题</text>
            <input
              class="home-form-input"
              value="{{shareConfig.shareTitle}}"
              placeholder="请输入分享给朋友的标题"
              bindinput="onInputShareTitle"
            />
          </view>
          <!-- 分享到朋友圈标题 -->
          <view class="home-form-item">
            <text class="home-form-label">分享到朋友圈标题</text>
            <input
              class="home-form-input"
              value="{{shareConfig.timelineTitle}}"
              placeholder="请输入分享到朋友圈的标题"
              bindinput="onInputTimelineTitle"
            />
          </view>
          <!-- 分享给朋友图片 -->
          <view class="home-form-item">
            <text class="home-form-label">分享给朋友图片</text>
            <view class="share-image-upload" bindtap="onChooseShareImage" data-type="share">
              <block wx:if="{{shareConfig.shareImage}}">
                <image src="{{shareConfig.shareImage}}" class="share-image-preview" mode="aspectFill"></image>
              </block>
              <block wx:else>
                <image src="/assets/CodeBubbyAssets/4_1184/1.svg" class="share-image-placeholder" mode="aspectFit"></image>
              </block>
            </view>
          </view>
          <!-- 分享到朋友圈图片 -->
          <view class="home-form-item">
            <text class="home-form-label">分享到朋友圈图片</text>
            <view class="share-image-upload" bindtap="onChooseShareImage" data-type="timeline">
              <block wx:if="{{shareConfig.timelineImage}}">
                <image src="{{shareConfig.timelineImage}}" class="share-image-preview" mode="aspectFill"></image>
              </block>
              <block wx:else>
                <image src="/assets/CodeBubbyAssets/4_1184/1.svg" class="share-image-placeholder" mode="aspectFit"></image>
              </block>
            </view>
          </view>
          <!-- 分享路径 -->
          <view class="home-form-item">
            <text class="home-form-label">分享路径</text>
            <input
              class="home-form-input"
              value="{{shareConfig.path}}"
              placeholder="/pages/index/index"
              bindinput="onInputSharePath"
            />
          </view>
          <!-- 操作按钮 -->
          <view class="home-form-actions">
            <view class="home-action-save" bindtap="onSaveShareConfig">
              <text class="home-action-save-text">保存</text>
            </view>
            <view class="home-action-cancel" bindtap="onCancelShareConfig">
              <text class="home-action-cancel-text">取消</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 桌面点单二维码 -->
      <view class="home-settings-card">
        <text class="home-settings-title">桌面点单二维码</text>
        <text class="home-hero-hint">为每张桌子生成专属小程序码，顾客扫码即可点单</text>

        <!-- 新增桌位按钮 -->
        <view class="home-action-save" bindtap="onAddTable" style="margin-top: 24rpx;">
          <text class="home-action-save-text">＋ 新增桌位</text>
        </view>

        <!-- 桌位列表 -->
        <view wx:if="{{tables.length > 0}}" class="table-list">
          <view wx:for="{{tables}}" wx:key="_id" class="table-row">
            <!-- QR 预览 -->
            <view class="table-qr-preview">
              <image wx:if="{{item.qrTempURL}}" src="{{item.qrTempURL}}" mode="aspectFit" class="table-qr-img"></image>
              <view wx:else class="table-qr-placeholder">
                <text class="table-qr-placeholder-text">未生成</text>
              </view>
            </view>
            <!-- 桌位信息 -->
            <view class="table-info">
              <text class="table-name-text">{{item.name}}</text>
              <text class="table-status-text" wx:if="{{!item.enabled}}">已禁用</text>
            </view>
            <!-- 操作按钮 -->
            <view class="table-actions">
              <view class="table-action-btn table-action-primary" bindtap="onGenerateQR" data-id="{{item._id}}">
                <text class="table-action-text">{{item.qrFileID ? '重新生成' : '生成'}}</text>
              </view>
              <view wx:if="{{item.qrFileID}}" class="table-action-btn table-action-download" bindtap="onDownloadQR" data-id="{{item._id}}">
                <text class="table-action-text">下载</text>
              </view>
              <view class="table-action-btn table-action-edit" bindtap="onEditTable" data-id="{{item._id}}">
                <text class="table-action-text">编辑</text>
              </view>
              <view class="table-action-btn table-action-delete" bindtap="onDeleteTable" data-id="{{item._id}}">
                <text class="table-action-text">删除</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:elif="{{_tablesLoaded}}" class="empty-tip" style="padding: 40rpx 0;">
          <text class="empty-text">暂无桌位，点击上方按钮添加</text>
        </view>
      </view>

    </view>

  </view>
</scroll-view>

<!-- ========== 新增/编辑桌位弹窗 ========== -->
<view wx:if="{{showTableModal}}" class="pm-mask" catchtap="onCloseTableModal"></view>
<view wx:if="{{showTableModal}}" class="pm-box">
  <view class="pm-header">
    <text class="pm-title">{{editingTable.id ? '编辑桌位' : '新增桌位'}}</text>
    <view class="pm-close" bindtap="onCloseTableModal">
      <text class="pm-close-text">✕</text>
    </view>
  </view>
  <view class="pm-content">
    <!-- 桌位名称 -->
    <view class="pm-field">
      <text class="pm-label">桌位名称</text>
      <input
        class="pm-input"
        value="{{editingTable.name}}"
        placeholder="例如：1号桌、靠窗座位"
        placeholder-class="pm-placeholder"
        bindinput="onInputTableName"
      />
    </view>
    <!-- 启用状态 -->
    <view class="pm-field">
      <text class="pm-label">启用</text>
      <view class="pm-switch-row">
        <switch checked="{{editingTable.enabled}}" bindchange="onToggleTableEnabled" color="#C08A4D"/>
        <text class="pm-switch-text">{{editingTable.enabled ? '启用' : '禁用'}}</text>
      </view>
    </view>
  </view>
  <view class="pm-footer">
    <view class="pm-save-btn" bindtap="onSaveTable">
      <text class="pm-save-text">保存</text>
    </view>
    <view class="pm-cancel-btn" bindtap="onCloseTableModal">
      <text class="pm-cancel-text">取消</text>
    </view>
  </view>
</view>

<!-- ========== 新增/编辑商品弹窗 ========== -->
<view wx:if="{{showProductModal}}" class="pm-mask" catchtap="onCloseProductModal"></view>
<view wx:if="{{showProductModal}}" class="pm-box">

  <!-- 标题行 -->
  <view class="pm-header">
    <text class="pm-title">{{editingProduct.id ? '编辑商品' : '新增商品'}}</text>
    <view class="pm-close" bindtap="onCloseProductModal">
      <image src="/assets/CodeBubbyAssets/4_1184/2.svg" class="pm-close-icon" mode="aspectFit"></image>
    </view>
  </view>

  <view class="pm-scroll">

    <!-- 商品图片 -->
    <view class="pm-field">
      <text class="pm-label">商品图片</text>
      <view class="pm-upload-area" bindtap="onChooseImage">
        <block wx:if="{{editingProduct.imagePreview}}">
          <image src="{{editingProduct.imagePreview}}" class="pm-preview-img" mode="aspectFill"></image>
        </block>
        <block wx:else>
          <image src="/assets/CodeBubbyAssets/4_1184/1.svg" class="pm-upload-icon" mode="aspectFit"></image>
        </block>
      </view>
    </view>

    <!-- 商品名称 -->
    <view class="pm-field">
      <text class="pm-label">商品名称</text>
      <input
        class="pm-input"
        value="{{editingProduct.name}}"
        placeholder="请输入商品名称"
        placeholder-class="pm-placeholder"
        bindinput="onInputProductName"
      />
    </view>

    <!-- 商品类别 -->
    <view class="pm-field">
      <text class="pm-label">商品类别</text>
      <picker
        class="pm-picker"
        mode="selector"
        range="{{categoryOptions}}"
        range-key="label"
        value="{{editingProduct.categoryIndex}}"
        bindchange="onPickerCategory"
      >
        <view class="pm-picker-inner">
          <text class="pm-picker-text">{{editingProduct.categoryLabel}}</text>
          <text class="pm-picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- 价格独行（冰淇淋按球数计价，不显示价格输入） -->
    <view wx:if="{{editingProduct.category !== 'icecream'}}" class="pm-field">
      <text class="pm-label">价格（元）</text>
      <input
        class="pm-input pm-input-short"
        type="digit"
        value="{{editingProduct.price}}"
        placeholder="0"
        placeholder-class="pm-placeholder"
        bindinput="onInputProductPrice"
      />
    </view>

    <!-- 温度选项（冰淇淋默认冰，不显示温度勾选） -->
    <view wx:if="{{editingProduct.category !== 'icecream'}}" class="pm-field">
      <text class="pm-label">温度选项</text>
      <view class="pm-checkbox-group">
        <view class="pm-checkbox-item" bindtap="onToggleIce">
          <view class="pm-checkbox-box {{editingProduct.supportIce ? 'pm-checkbox-checked' : ''}}">
            <text wx:if="{{editingProduct.supportIce}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-checkbox-label">冰</text>
        </view>
        <view class="pm-checkbox-item" bindtap="onToggleHot">
          <view class="pm-checkbox-box {{editingProduct.supportHot ? 'pm-checkbox-checked' : ''}}">
            <text wx:if="{{editingProduct.supportHot}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-checkbox-label">热</text>
        </view>
        <view class="pm-checkbox-item" bindtap="onToggleNormal">
          <view class="pm-checkbox-box {{editingProduct.supportNormal ? 'pm-checkbox-checked' : ''}}">
            <text wx:if="{{editingProduct.supportNormal}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-checkbox-label">常温</text>
        </view>
      </view>
    </view>

    <!-- 拼球选项与价格（仅冰淇淋类，可全局或单独定价） -->
    <view wx:if="{{editingProduct.category === 'icecream'}}" class="pm-field">
      <text class="pm-label">拼球选项与价格</text>
      <view class="pm-checkbox-group">
        <view class="pm-checkbox-item" bindtap="onToggleScoopPriceMode" data-val="global">
          <view class="pm-checkbox-box {{editingProduct.scoopPriceMode === 'global' ? 'pm-checkbox-checked' : ''}}">
            <text wx:if="{{editingProduct.scoopPriceMode === 'global'}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-checkbox-label">全局定价</text>
        </view>
        <view class="pm-checkbox-item" bindtap="onToggleScoopPriceMode" data-val="custom">
          <view class="pm-checkbox-box {{editingProduct.scoopPriceMode === 'custom' ? 'pm-checkbox-checked' : ''}}">
            <text wx:if="{{editingProduct.scoopPriceMode === 'custom'}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-checkbox-label">单独定价</text>
        </view>
      </view>
      <view class="pm-scoop-group">
        <view class="pm-scoop-row">
          <view class="pm-checkbox-box {{editingProduct.scoopChecked['单球'] ? 'pm-checkbox-checked' : ''}}" bindtap="onToggleScoop" data-val="单球">
            <text wx:if="{{editingProduct.scoopChecked['单球']}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-scoop-label">单球</text>
          <input class="pm-input pm-input-small" type="digit" value="{{editingProduct.scoopPriceMode === 'custom' ? editingProduct.scoopPrices.single : scoopPrices.single}}" data-key="single" bindinput="onInputScoopPrice" catchtap="noop" />
          <text class="pm-scoop-unit">元</text>
        </view>
        <view class="pm-scoop-row">
          <view class="pm-checkbox-box {{editingProduct.scoopChecked['双球'] ? 'pm-checkbox-checked' : ''}}" bindtap="onToggleScoop" data-val="双球">
            <text wx:if="{{editingProduct.scoopChecked['双球']}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-scoop-label">双球</text>
          <input class="pm-input pm-input-small" type="digit" value="{{editingProduct.scoopPriceMode === 'custom' ? editingProduct.scoopPrices.double : scoopPrices.double}}" data-key="double" bindinput="onInputScoopPrice" catchtap="noop" />
          <text class="pm-scoop-unit">元</text>
        </view>
        <view class="pm-scoop-row">
          <view class="pm-checkbox-box {{editingProduct.scoopChecked['三球'] ? 'pm-checkbox-checked' : ''}}" bindtap="onToggleScoop" data-val="三球">
            <text wx:if="{{editingProduct.scoopChecked['三球']}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-scoop-label">三球</text>
          <input class="pm-input pm-input-small" type="digit" value="{{editingProduct.scoopPriceMode === 'custom' ? editingProduct.scoopPrices.triple : scoopPrices.triple}}" data-key="triple" bindinput="onInputScoopPrice" catchtap="noop" />
          <text class="pm-scoop-unit">元</text>
        </view>
      </view>
    </view>

    <!-- 可拼球开关（仅冰淇淋类） -->
    <view wx:if="{{editingProduct.category === 'icecream'}}" class="pm-field">
      <text class="pm-label">可拼球</text>
      <view class="pm-checkbox-group">
        <view class="pm-checkbox-item" bindtap="onToggleScoopEnabled">
          <view class="pm-checkbox-box {{editingProduct.scoopEnabled ? 'pm-checkbox-checked' : ''}}">
            <text wx:if="{{editingProduct.scoopEnabled}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-checkbox-label">该商品可作为拼球口味</text>
        </view>
      </view>
    </view>

    <!-- 烘焙度和处理法（仅咖啡类） -->
    <view wx:if="{{editingProduct.category === 'coffee'}}" class="pm-field">
      <text class="pm-label">烘焙度</text>

      <!-- 烘焙度预设选项 -->
      <view class="pm-roast-group">
        <picker
          mode="selector"
          range="{{roastLevelOptions}}"
          value="{{editingProduct.roastLevelIndex}}"
          bindchange="onPickerRoastLevel"
        >
          <view class="pm-picker-inner pm-picker-small">
            <text class="pm-picker-text">{{editingProduct.roastLevel || '请选择烘焙度'}}</text>
            <text class="pm-picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <!-- 自定义烘焙度输入 -->
      <view class="pm-custom-input-wrapper">
        <view class="pm-custom-input-label">
          <text class="pm-custom-input-text">自定义：</text>
        </view>
        <input
          class="pm-input pm-input-small"
          value="{{editingProduct.customRoast}}"
          placeholder="或输入自定义烘焙度"
          placeholder-class="pm-placeholder"
          bindinput="onInputCustomRoast"
          bindblur="onBlurCustomRoast"
        />
      </view>
    </view>

    <!-- 处理法（仅咖啡类） -->
    <view wx:if="{{editingProduct.category === 'coffee'}}" class="pm-field">
      <text class="pm-label">处理法</text>

      <!-- 处理法预设选项 -->
      <view class="pm-process-group">
        <picker
          mode="selector"
          range="{{processingMethodOptions}}"
          value="{{editingProduct.processingMethodIndex}}"
          bindchange="onPickerProcessingMethod"
        >
          <view class="pm-picker-inner pm-picker-small">
            <text class="pm-picker-text">{{editingProduct.processingMethod || '请选择处理法'}}</text>
            <text class="pm-picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <!-- 自定义处理法输入 -->
      <view class="pm-custom-input-wrapper">
        <view class="pm-custom-input-label">
          <text class="pm-custom-input-text">自定义：</text>
        </view>
        <input
          class="pm-input pm-input-small"
          value="{{editingProduct.customProcessing}}"
          placeholder="或输入自定义处理法"
          placeholder-class="pm-placeholder"
          bindinput="onInputCustomProcessing"
          bindblur="onBlurCustomProcessing"
        />
      </view>
    </view>

    <!-- 规格（冰淇淋用风味标签替代） -->
    <view wx:if="{{editingProduct.category !== 'icecream'}}" class="pm-field">
      <text class="pm-label">规格（可选）</text>
      <input
        class="pm-input"
        value="{{editingProduct.spec}}"
        placeholder="例如：中杯、大杯、单球、双球等"
        placeholder-class="pm-placeholder"
        bindinput="onInputSpec"
      />
    </view>

    <!-- 风味标签（冰淇淋 / 巧克力排块，用 ; 或 ；分隔） -->
    <view wx:if="{{editingProduct.category === 'icecream' || editingProduct.category === 'bar'}}" class="pm-field">
      <text class="pm-label">风味标签（用 ; 分隔）</text>
      <input
        class="pm-input"
        value="{{editingProduct.flavors}}"
        placeholder="例如：香草;巧克力;抹茶"
        placeholder-class="pm-placeholder"
        bindinput="onInputFlavors"
      />
    </view>

    <!-- 其他可选（加料名列表 + 单选/多选，所有类别） -->
    <view class="pm-field">
      <text class="pm-label">其他可选（加料）</text>
      <view class="pm-checkbox-group">
        <view class="pm-checkbox-item" bindtap="onToggleToppingMode" data-val="multi">
          <view class="pm-checkbox-box {{editingProduct.toppingMode === 'multi' ? 'pm-checkbox-checked' : ''}}">
            <text wx:if="{{editingProduct.toppingMode === 'multi'}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-checkbox-label">多选</text>
        </view>
        <view class="pm-checkbox-item" bindtap="onToggleToppingMode" data-val="single">
          <view class="pm-checkbox-box {{editingProduct.toppingMode === 'single' ? 'pm-checkbox-checked' : ''}}">
            <text wx:if="{{editingProduct.toppingMode === 'single'}}" class="pm-checkbox-tick">✓</text>
          </view>
          <text class="pm-checkbox-label">单选</text>
        </view>
      </view>
      <view wx:for="{{editingProduct.toppings}}" class="pm-topping-row">
        <input
          class="pm-input"
          value="{{item}}"
          placeholder="材料名称，如：奥利奥碎"
          placeholder-class="pm-placeholder"
          bindinput="onInputTopping"
          data-index="{{index}}"
        />
        <view class="pm-topping-del" bindtap="onRemoveTopping" data-index="{{index}}">
          <text class="pm-topping-del-text">−</text>
        </view>
      </view>
      <view class="pm-topping-add" bindtap="onAddTopping">
        <text class="pm-topping-add-text">＋ 添加一项</text>
      </view>
    </view>

    <!-- 商品状态 -->
    <view class="pm-field">
      <text class="pm-label">商品状态</text>
      <view class="pm-status-group">
        <view
          class="pm-status-btn {{editingProduct.saleStatus === 'on' ? 'pm-status-active' : ''}}"
          bindtap="onSelectStatus"
          data-status="on"
        >
          <text class="pm-status-text {{editingProduct.saleStatus === 'on' ? 'pm-status-text-active' : ''}}">上架</text>
        </view>
        <view
          class="pm-status-btn {{editingProduct.saleStatus === 'off' ? 'pm-status-active' : ''}}"
          bindtap="onSelectStatus"
          data-status="off"
        >
          <text class="pm-status-text {{editingProduct.saleStatus === 'off' ? 'pm-status-text-active' : ''}}">下架</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 底部按钮 -->
  <view class="pm-footer">
    <view class="pm-save-btn" bindtap="onSaveProduct">
      <text class="pm-save-text">保存</text>
    </view>
    <view class="pm-cancel-btn" bindtap="onCloseProductModal">
      <text class="pm-cancel-text">取消</text>
    </view>
  </view>

</view>

<!-- ========== 快速编辑烘焙度弹窗 ========== -->
<view wx:if="{{showQuickRoastModal}}" class="quick-modal-mask" catchtap="onCloseQuickRoastModal"></view>
<view wx:if="{{showQuickRoastModal}}" class="quick-modal-box">
  <view class="quick-modal-header">
    <text class="quick-modal-title">选择烘焙度</text>
    <view class="quick-modal-close" bindtap="onCloseQuickRoastModal">
      <text class="quick-modal-close-text">✕</text>
    </view>
  </view>
  <view class="quick-modal-content">
    <view class="quick-option-list">
      <view
        wx:for="{{roastLevelOptions}}"
        wx:key="*this"
        class="quick-option-item {{item === quickEditingRoast ? 'quick-option-selected' : ''}}"
        bindtap="onSelectQuickRoast"
        data-roast="{{item}}"
      >
        <text class="quick-option-text">{{item}}</text>
        <text wx:if="{{item === quickEditingRoast}}" class="quick-option-check">✓</text>
      </view>
    </view>
  </view>
  <view class="quick-modal-footer">
    <view class="quick-modal-btn quick-modal-cancel" bindtap="onCloseQuickRoastModal">
      <text class="quick-modal-btn-text">取消</text>
    </view>
    <view class="quick-modal-btn quick-modal-confirm" bindtap="onSaveQuickRoast">
      <text class="quick-modal-btn-text">确定</text>
    </view>
  </view>
</view>

<!-- ========== 快速编辑处理法弹窗 ========== -->
<view wx:if="{{showQuickProcessingModal}}" class="quick-modal-mask" catchtap="onCloseQuickProcessingModal"></view>
<view wx:if="{{showQuickProcessingModal}}" class="quick-modal-box">
  <view class="quick-modal-header">
    <text class="quick-modal-title">选择处理法</text>
    <view class="quick-modal-close" bindtap="onCloseQuickProcessingModal">
      <text class="quick-modal-close-text">✕</text>
    </view>
  </view>
  <view class="quick-modal-content">
    <view class="quick-option-list">
      <view
        wx:for="{{processingMethodOptions}}"
        wx:key="*this"
        class="quick-option-item {{item === quickEditingProcessing ? 'quick-option-selected' : ''}}"
        bindtap="onSelectQuickProcessing"
        data-processing="{{item}}"
      >
        <text class="quick-option-text">{{item}}</text>
        <text wx:if="{{item === quickEditingProcessing}}" class="quick-option-check">✓</text>
      </view>
    </view>
  </view>
  <view class="quick-modal-footer">
    <view class="quick-modal-btn quick-modal-cancel" bindtap="onCloseQuickProcessingModal">
      <text class="quick-modal-btn-text">取消</text>
    </view>
    <view class="quick-modal-btn quick-modal-confirm" bindtap="onSaveQuickProcessing">
      <text class="quick-modal-btn-text">确定</text>
    </view>
  </view>
</view>

<!-- ========== 快速编辑商品状态弹窗 ========== -->
<view wx:if="{{showQuickStatusModal}}" class="quick-modal-mask" catchtap="onCloseQuickStatusModal"></view>
<view wx:if="{{showQuickStatusModal}}" class="quick-modal-box">
  <view class="quick-modal-header">
    <text class="quick-modal-title">选择商品状态</text>
    <view class="quick-modal-close" bindtap="onCloseQuickStatusModal">
      <text class="quick-modal-close-text">✕</text>
    </view>
  </view>
  <view class="quick-modal-content">
    <view class="quick-option-list">
      <view
        class="quick-option-item {{quickEditingStatus === 'on' ? 'quick-option-selected' : ''}}"
        bindtap="onSelectQuickStatus"
        data-status="on"
      >
        <text class="quick-option-text">上架</text>
        <text wx:if="{{quickEditingStatus === 'on'}}" class="quick-option-check">✓</text>
      </view>
      <view
        class="quick-option-item {{quickEditingStatus === 'off' ? 'quick-option-selected' : ''}}"
        bindtap="onSelectQuickStatus"
        data-status="off"
      >
        <text class="quick-option-text">下架</text>
        <text wx:if="{{quickEditingStatus === 'off'}}" class="quick-option-check">✓</text>
      </view>
    </view>
  </view>
  <view class="quick-modal-footer">
    <view class="quick-modal-btn quick-modal-cancel" bindtap="onCloseQuickStatusModal">
      <text class="quick-modal-btn-text">取消</text>
    </view>
    <view class="quick-modal-btn quick-modal-confirm" bindtap="onSaveQuickStatus">
      <text class="quick-modal-btn-text">确定</text>
    </view>
  </view>
</view>

<!-- ========== 选择商品弹窗（首页商品展示） ========== -->
<view wx:if="{{showFeaturedPicker}}" class="quick-modal-mask" catchtap="onCloseFeaturedPicker"></view>
<view wx:if="{{showFeaturedPicker}}" class="quick-modal-box">
  <view class="quick-modal-header">
    <text class="quick-modal-title">选择展示商品</text>
    <view class="quick-modal-close" bindtap="onCloseFeaturedPicker">
      <text class="quick-modal-close-text">✕</text>
    </view>
  </view>
  <scroll-view scroll-y class="quick-modal-content" style="max-height: 60vh;">
    <view class="quick-option-list">
      <view
        wx:for="{{featuredPickerProducts}}"
        wx:key="_id"
        class="quick-option-item"
        bindtap="onSelectFeaturedProduct"
        data-index="{{index}}"
      >
        <text class="quick-option-text">{{item.name}}（¥{{item.price}}）</text>
      </view>
    </view>
  </scroll-view>

</view>

<!-- ========== 长期打烊日期选择弹窗 ========== -->
<view wx:if="{{showCloseDatePicker}}" class="quick-modal-mask" catchtap="onCancelCloseDate"></view>
<view wx:if="{{showCloseDatePicker}}" class="quick-modal-box">
  <view class="quick-modal-header">
    <text class="quick-modal-title">选择恢复营业日期</text>
    <view class="quick-modal-close" bindtap="onCancelCloseDate">
      <text class="quick-modal-close-text">✕</text>
    </view>
  </view>
  <view class="quick-modal-content" style="padding: 32rpx;">
    <text style="font-size:26rpx;color:#8B6F5E;display:block;margin-bottom:24rpx;text-align:center">将于选定日期 {{openingTime || '09:30'}} 恢复营业</text>
    <picker mode="date" value="{{closeUntilDate}}" bindchange="onCloseDateChange">
      <view class="pm-picker-inner"><text class="pm-picker-text">{{closeUntilDate || '请选择日期'}}</text><text class="pm-picker-arrow">▾</text></view>
    </picker>
  </view>
  <view class="quick-modal-footer">
    <view class="quick-modal-btn quick-modal-cancel" bindtap="onCancelCloseDate">
      <text class="quick-modal-btn-text">取消</text>
    </view>
    <view class="quick-modal-btn quick-modal-confirm" bindtap="onConfirmCloseDate">
      <text class="quick-modal-btn-text">确定</text>
    </view>
  </view>
</view>

<!-- ========== 退款选择弹窗 ========== -->
<view wx:if="{{refundModal}}" class="refund-mask" bindtap="onCloseRefund">
  <view class="refund-modal" catchtap="noop">
    <view class="refund-modal-header">
      <text class="refund-modal-title">选择退款商品</text>
      <text class="refund-modal-close" bindtap="onCloseRefund">✕</text>
    </view>
    <scroll-view class="refund-modal-body" scroll-y>
      <view
        wx:for="{{refundModal.candidates}}"
        wx:key="index"
        wx:for-item="c"
        wx:for-index="idx"
        class="refund-candidate {{c.refunded ? 'refund-candidate-disabled' : ''}}"
        bindtap="onToggleRefundItem"
        data-index="{{idx}}"
      >
        <view class="refund-checkbox {{c.selected && !c.refunded ? 'refund-checkbox-on' : ''}}">
          <text wx:if="{{c.selected && !c.refunded}}" class="refund-checkbox-tick">✓</text>
        </view>
        <view class="refund-candidate-info">
          <text class="refund-candidate-name">{{c.name}}</text>
          <text wx:if="{{c.spec}}" class="refund-candidate-spec">{{c.spec}}</text>
        </view>
        <text wx:if="{{c.refunded}}" class="refund-candidate-refunded">已退款</text>
        <text wx:else class="refund-candidate-price">¥{{c.price}}</text>
      </view>
    </scroll-view>
    <view class="refund-modal-footer">
      <view class="refund-modal-actions">
        <text class="refund-select-all" bindtap="onSelectAllRefund">全选</text>
        <text class="refund-modal-amount">合计退款 ¥{{refundModal.selectedAmount}}</text>
      </view>
      <view class="refund-modal-btns">
        <view class="refund-btn-cancel" bindtap="onCloseRefund"><text>取消</text></view>
        <view class="refund-btn-confirm" bindtap="onConfirmRefund"><text>确认退款</text></view>
      </view>
    </view>
  </view>
</view>
