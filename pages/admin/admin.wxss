/* admin.wxss */

page {
  background: #F9F5F0;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== 主滚动区 ===== */
.admin-scroll {
  flex: 1;
  overflow-y: hidden;
}

.admin-body {
  padding: 32rpx 48rpx 48rpx;
}

/* ===== 通知授权横幅 ===== */
.subscribe-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #A3212D, #C0392B);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
}

.subscribe-banner-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.subscribe-banner-text {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.subscribe-banner-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ===== 打烊开关 ===== */
.close-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #E8F5E9;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
}

.close-toggle.close-active {
  background: #FFEBEE;
}

.close-toggle-icon {
  font-size: 36rpx;
}

.close-toggle-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #2E7D32;
}

.close-active .close-toggle-text {
  color: #C62828;
}

.close-toggle-hint {
  font-size: 22rpx;
  color: rgba(0,0,0,0.35);
}

/* ===== Tab 切换栏 ===== */
.tab-bar {
  display: flex;
  background: #E7DDD1;
  border-radius: 32rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}

.tab-item {
  flex: 1;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.tab-active {
  background: #A3212D;
}

.tab-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #5B3A29;
}

.tab-text-active {
  color: #FFFFFF;
}

/* ===== Tab 内容区 ===== */
.tab-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.placeholder-text {
  text-align: center;
  color: #8B6F5E;
  font-size: 28rpx;
  padding: 80rpx 0;
}

/* ===== 统计周期选择 ===== */
.stats-period-bar {
  display: flex;
  background: #E7DDD1;
  border-radius: 32rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.period-btn {
  flex: 1;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.period-active {
  background: #A3212D;
}

.period-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #5B3A29;
}

.period-text-active {
  color: #FFFFFF;
}

/* ===== 统计卡片 ===== */
.stat-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.stat-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.stat-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.stat-icon-red   { background: rgba(163, 33, 45, 0.10); }
.stat-icon-gold  { background: rgba(192, 138, 77, 0.10); }
.stat-icon-brown { background: rgba(91, 58, 41, 0.10); }

.stat-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.stat-card-label {
  font-size: 32rpx;
  color: rgba(91, 58, 41, 0.60);
}

.stat-card-value {
  font-size: 60rpx;
  font-weight: 400;
}

.stat-value-red   { color: #A3212D; }
.stat-value-gold  { color: #C08A4D; }
.stat-value-brown { color: #5B3A29; }

/* 线上支付（绿）/ 线下支付（青，与店员端「线下支付」标签同色） */
.stat-icon-green  { background: rgba(46, 125, 50, 0.10); }
.stat-icon-blue   { background: rgba(14, 116, 144, 0.10); }
.stat-value-green { color: #2E7D32; }
.stat-value-blue  { color: #0E7490; }

/* ===== 卡片内多指标网格（合并卡片用） ===== */
.stat-grid { display: flex; gap: 32rpx; }
.stat-grid--top {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 2rpx solid #F2E8DD;
}
.stat-cell { flex: 1; min-width: 0; }
.stat-cell-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.stat-cell-icon { width: 56rpx; height: 56rpx; border-radius: 18rpx; margin-right: 16rpx; }
.stat-cell-icon-img { width: 28rpx; height: 28rpx; }
.stat-cell-label { font-size: 26rpx; color: rgba(91, 58, 41, 0.60); }
.stat-cell-value { font-size: 44rpx; font-weight: 500; }

/* ===== 商品销售排行 ===== */
.ranking-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.ranking-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #5B3A29;
  margin-bottom: 32rpx;
  display: block;
}

.ranking-list {
  display: flex;
  flex-direction: column;
}

.ranking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.ranking-row-border {
  border-bottom: 1rpx solid #E7DDD1;
}

.ranking-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.rank-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rank-badge-1 { background: #A3212D; }
.rank-badge-2 { background: #C08A4D; }
.rank-badge-3 { background: #5B3A29; }
.rank-badge-other { background: #E7DDD1; }

.rank-num {
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.rank-name {
  font-size: 28rpx;
  color: #5B3A29;
}

.ranking-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.rank-sales {
  font-size: 24rpx;
  color: rgba(91, 58, 41, 0.60);
  margin-bottom: 8rpx;
}

.rank-revenue {
  font-size: 28rpx;
  font-weight: 500;
  color: #C08A4D;
}

/* ===== 冰淇淋大类排行行（固定置顶 + 可收起的口味球数下拉） ===== */
.rank-badge-icecream {
  background: #C08A4D;
}

.icecream-rank-row {
  border-bottom: 1rpx solid #E7DDD1;
}

.icecream-title-wrap {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.icecream-arrow {
  margin-top: 4rpx;
  font-size: 42rpx;
  line-height: 1;
  color: rgba(91, 58, 41, 0.55);
  transition: transform 0.2s;
}

.icecream-arrow-open {
  transform: rotate(180deg);
}

.flavor-breakdown {
  padding: 8rpx 0 16rpx 72rpx;
  border-bottom: 1rpx solid #E7DDD1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.flavor-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flavor-name {
  font-size: 26rpx;
  color: rgba(91, 58, 41, 0.85);
}

.flavor-scoops {
  font-size: 26rpx;
  font-weight: 500;
  color: #C08A4D;
}

/* ===== 商品管理 Tab ===== */
.category-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.category-btn {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: #E7DDD1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-btn-active {
  background: #A3212D;
}

.category-btn-text {
  font-size: 24rpx;
  color: #5B3A29;
}

.category-btn-text-active {
  color: #FFFFFF;
}

.add-product-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.add-product-btn {
  flex: 1;
  height: 80rpx;
  background: #A3212D;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.refresh-btn {
  width: 120rpx;
  height: 80rpx;
  background: #F9F5F0;
  border: 1rpx solid #C08A4D;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.refresh-btn-text {
  font-size: 26rpx;
  color: #C08A4D;
}

.status-filter {
  margin-top: 0;
}

.add-product-icon {
  width: 36rpx;
  height: 36rpx;
}

.add-product-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.products-loading,
.products-empty {
  padding: 60rpx 0;
  text-align: center;
}

.products-loading-text,
.products-empty-text {
  font-size: 26rpx;
  color: #999;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06);
}

.product-card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #F0E8DF;
}

.product-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #3A2318;
  display: block;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 商品卡片中的咖啡信息标签 */
.coffee-info-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.coffee-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-weight: 400;
  cursor: pointer;
  transition: all 0.2s;
  user-select: none;
}

.coffee-tag:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.roast-tag {
  background: rgba(139, 90, 43, 0.15);
  color: #8B5A2B;
}

.process-tag {
  background: rgba(114, 140, 153, 0.15);
  color: #728C99;
}

.product-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.product-price {
  font-size: 26rpx;
  color: #A3212D;
  font-weight: 500;
}

.product-sales {
  font-size: 22rpx;
  color: #A8988B;
}

.product-tag {
  background: #F5EDE4;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.product-tag-text {
  font-size: 22rpx;
  color: #8B6F5E;
}

.product-status-tag {
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  cursor: pointer;
  transition: all 0.2s;
  user-select: none;
}

.product-status-tag:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.product-status-on   { background: rgba(39, 167, 79, 0.12); }
.product-status-off  { background: rgba(91, 58, 41, 0.10); }

.product-status-text {
  font-size: 22rpx;
}

.product-status-on   .product-status-text { color: #27A74F; }
.product-status-off  .product-status-text { color: #8B6F5E; }

.product-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.product-action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #F5EDE4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-action-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 新增/编辑商品弹窗 ===== */
.pm-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
}

.pm-box {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  max-height: 88vh;
}

.pm-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 48rpx 24rpx;
  flex-shrink: 0;
}

.pm-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3A2318;
}

.pm-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pm-close-icon {
  width: 32rpx;
  height: 32rpx;
}

.pm-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0 48rpx;
  box-sizing: border-box;
  width: 100%;
}

.pm-field {
  margin-bottom: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.pm-label {
  font-size: 26rpx;
  color: rgba(58, 35, 24, 0.60);
  display: block;
  margin-bottom: 12rpx;
}

.pm-upload-area {
  width: 240rpx;
  height: 240rpx;
  border: 2rpx dashed #C9A98A;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAF6F2;
  overflow: hidden;
  box-sizing: border-box;
}

.pm-upload-icon {
  width: 96rpx;
  height: 96rpx;
}

.pm-upload-tip {
  font-size: 26rpx;
  color: #8B6F5E;
  margin-bottom: 8rpx;
}

.pm-upload-hint {
  font-size: 22rpx;
  color: rgba(139, 111, 94, 0.60);
}

.pm-preview-img {
  width: 100%;
  height: 100%;
}

.pm-input {
  width: 100%;
  height: 80rpx;
  background: #F5EDE4;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #3A2318;
  box-sizing: border-box;
}

.pm-placeholder {
  color: rgba(58, 35, 24, 0.35);
}

.pm-picker {
  width: 100%;
  box-sizing: border-box;
}

.pm-picker-inner {
  width: 100%;
  height: 80rpx;
  background: #F5EDE4;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.pm-picker-text {
  font-size: 28rpx;
  color: #3A2318;
}

.pm-picker-arrow {
  font-size: 24rpx;
  color: #8B6F5E;
}

.pm-status-group {
  display: flex;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.pm-status-btn {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E7DDD1;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.pm-status-active {
  border-color: #A3212D;
  background: rgba(163, 33, 45, 0.08);
}

.pm-status-text {
  font-size: 26rpx;
  color: #8B6F5E;
}

.pm-status-text-active {
  color: #A3212D;
  font-weight: 500;
}

.pm-field-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

/* 勾选框组（温度选项、拼球选项） */
.pm-checkbox-group {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 24rpx;
}

.pm-checkbox-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pm-checkbox-label {
  font-size: 28rpx;
  color: #3A2318;
}

/* ========== 咖啡类专属样式 ========== */

/* 烘焙度和处理法选择器 */
.pm-roast-group,
.pm-process-group {
  margin-top: 12rpx;
}

.pm-picker-small {
  height: 64rpx;
  border: 2rpx solid #E7DCD1;
  border-radius: 12rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
}

.pm-picker-text {
  font-size: 28rpx;
  color: #5B3A29;
}

/* 自定义输入区域 */
.pm-custom-input-wrapper {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 12rpx;
}

.pm-custom-input-label {
  flex-shrink: 0;
}

.pm-custom-input-text {
  font-size: 24rpx;
  color: #B8A99E;
}

.pm-input-small {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
}

/* 旧的冰热同行布局（保留兼容） */
.pm-price-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 24rpx;
}

.pm-price-col {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
}

.pm-input-short {
  width: 100% !important;
}

.pm-icehot-col {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
  width: 160rpx;
}

.pm-icehot-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
}

.pm-label-inline {
  display: inline;
  margin-bottom: 0;
}

.pm-checkbox {
  flex-shrink: 0;
}

.pm-checkbox-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 2rpx solid #C9A98A;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pm-checkbox-checked {
  background: #A3212D;
  border-color: #A3212D;
}

.pm-checkbox-tick {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* 拼球选项与价格（冰淇淋，全局价格） */
.pm-scoop-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.pm-scoop-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pm-scoop-label {
  font-size: 28rpx;
  color: #3A2318;
  min-width: 80rpx;
}

.pm-scoop-row .pm-input {
  width: 160rpx;
  flex: none;
  height: 64rpx;
}

.pm-scoop-unit {
  font-size: 26rpx;
  color: rgba(58, 35, 24, 0.60);
}

/* 其他可选（加料）列表 */
.pm-topping-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.pm-topping-row .pm-input {
  flex: 1;
  height: 64rpx;
}

.pm-topping-row .pm-input.pm-topping-price {
  flex: 0 0 160rpx;
  text-align: center;
}

.pm-topping-del {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #A3212D;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pm-topping-del-text {
  font-size: 34rpx;
  line-height: 1;
  color: #A3212D;
}

.pm-topping-add {
  height: 64rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #C9B8A6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.pm-topping-add-text {
  font-size: 26rpx;
  color: #8B6F5E;
}

.pm-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 48rpx 48rpx;
  flex-shrink: 0;
}

.pm-save-btn {
  flex: 1;
  height: 88rpx;
  background: #A3212D;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pm-save-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
}

