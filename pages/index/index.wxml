<!--index.wxml-->
<!-- 导航栏 -->
<view class="navbar" style="padding-top: {{statusBarHeight}}px; height: calc({{statusBarHeight}}px + 44px);">
  <view class="navbar-content">
    <text class="navbar-title">贰零壹叁咖啡馆</text>
  </view>
</view>

<!-- 占位空间，防止内容被导航栏遮挡 -->
<view class="navbar-placeholder" style="height: calc({{statusBarHeight}}px + 44px);"></view>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    
    <!-- 桌位提示条 -->
    <view wx:if="{{tableContextActive}}" class="table-context-bar">
      <text class="table-context-text">🪑 当前桌位：{{tableContextName || '加载中...'}}</text>
      <view class="table-context-exit" bindtap="onClearTableContext">
        <text class="table-context-exit-text">退出桌位</text>
      </view>
    </view>

    <!-- Banner 轮播图 -->
    <view class="banner-container">
      <!-- 有自定义图片时：swiper 轮播 -->
      <swiper
        wx:if="{{heroImages.length > 0}}"
        class="banner-swiper"
        autoplay
        interval="3500"
        circular
        indicator-dots="{{false}}"
      >
        <swiper-item wx:for="{{heroImages}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill" class="banner-image"></image>
        </swiper-item>
      </swiper>

      <!-- 无自定义图片时：显示品牌色占位背景（通过 CSS 处理） -->
      <view wx:else class="banner-placeholder"></view>
    </view>

    <!-- 打烊浮窗 -->
    <view wx:if="{{shopClosed}}" class="closed-overlay" bindtap="onOverlayTap" bindlongpress="onOverlayLongPress">
      <view class="closed-overlay-box">
        <text class="closed-title">{{closedTitle}}</text>
        <text wx:if="{{closedMessage}}" class="closed-msg">{{closedMessage}}</text>
      </view>
    </view>

    <!-- 堂食/外带选择区 -->
    <view class="dining-options">
      <!-- 堂食 -->
      <view class="option-card" bindtap="onDineInTap" bindlongpress="onDineInLongPress">
        <view class="option-icon dine-in-icon">
          <image src="/images/icons/dine-in.svg" class="option-svg" mode="aspectFit"></image>
        </view>
        <view class="option-content">
          <text class="option-title">堂食</text>
          <text class="option-desc">店内享用</text>
        </view>
      </view>

      <!-- 外带 -->
      <view class="option-card" bindtap="onTakeawayTap" bindlongpress="onTakeawayLongPress">
        <view class="option-icon takeaway-icon">
          <image src="/images/icons/takeaway.svg" class="option-svg" mode="aspectFit"></image>
        </view>
        <view class="option-content">
          <text class="option-title">外带</text>
          <text class="option-desc">打包带走</text>
        </view>
      </view>
    </view>

    <!-- WiFi 连接按钮 -->
    <view class="wifi-button" bindtap="onConnectWifi">
      <image src="/public/images/wifi.svg" class="wifi-icon-svg" mode="aspectFit"></image>
      <text class="wifi-text">店内WiFi</text>
      <text class="arrow">→</text>
    </view>

    <!-- 首页商品展示（纵向排列） -->
    <view wx:if="{{featuredProducts.length > 0}}" class="featured-section">
      <view
        wx:for="{{featuredProducts}}"
        wx:key="productId"
        class="featured-card"
        bindtap="onFeaturedTap"
        data-id="{{item.productId}}"
      >
        <image src="{{item.imageURL}}" mode="aspectFill" class="featured-img"></image>
        <view class="featured-info">
          <text class="featured-name">{{item.name}}</text>
        </view>
      </view>
    </view>

  </view>
</scroll-view>
