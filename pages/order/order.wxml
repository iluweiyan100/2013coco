<!--order.wxml-->

<!-- 导航栏 -->
<view class="navbar" style="padding-top: {{statusBarHeight}}px; height: calc({{statusBarHeight}}px + 44px);">
  <view class="navbar-content">
    <text class="navbar-title">点 单</text>
  </view>
</view>

<!-- 占位空间，防止内容被导航栏遮挡 -->
<view class="navbar-placeholder" style="height: calc({{statusBarHeight}}px + 44px);"></view>

<!-- 桌位共享点单状态条 -->
<view wx:if="{{tableMode}}" class="table-mode-banner">
  <text class="table-mode-text">
    <block wx:if="{{tableStatus === 'open'}}">🪑 {{tableName}} · 本桌共享点单中</block>
    <block wx:elif="{{tableStatus === 'paying'}}">🪑 {{tableName}} · 本桌正在结算</block>
    <block wx:else>🪑 {{tableName}} · 已下单 取餐码 {{tablePickupNumber}}</block>
  </text>
</view>

<view class="order-container">
  
  <!-- 主内容区：双栏布局 -->
  <view class="main-content">
    
    <!-- 左侧：分类导航 + 桌位 -->
    <view class="category-column">
      <scroll-view class="category-sidebar" scroll-y>
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="sidebar-item {{currentCategory === item.id ? 'active' : ''}}"
          bindtap="onCategoryChange"
          data-id="{{item.id}}"
        >
          <text>{{item.name}}</text>
        </view>
      </scroll-view>
      <!-- 桌位信息（固定于侧边栏底部，不随分类滚动） -->
      <view wx:if="{{tableName}}" class="sidebar-table-badge">
        <text class="sidebar-table-text">🪑 {{tableName}}</text>
      </view>
    </view>

    <!-- 右侧商品列表 - 显示所有商品 -->
    <scroll-view
      class="product-list"
      scroll-y
      scroll-into-view="{{scrollToView}}"
      scroll-with-animation
      bindscroll="onProductScroll"
    >
      <block wx:for="{{allProducts}}" wx:key="id">
        <!-- 分类标题（每个分类的第一个商品前显示） -->
        <view 
          wx:if="{{index === 0 || item.categoryId !== allProducts[index-1].categoryId}}" 
          class="category-title"
          id="category-{{item.categoryId}}"
        >
          <text>{{item.categoryName}}</text>
        </view>
        
        <!-- 商品卡片 -->
        <view class="product-card" id="product-{{index}}">
          <!-- 商品图片 -->
          <image src="{{item.image}}" mode="aspectFill" class="product-image" lazy-load bindtap="onPreviewImage" data-url="{{item.image}}"></image>
          
          <!-- 商品信息区 -->
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>

            <!-- 规格标签：合并显示冰/热/常温和咖啡烘焙度/处理法 -->
            <view class="spec-tags" wx:if="{{item.supportIce || item.supportHot || item.supportNormal || (item.categoryId === 'coffee' && (item.roastLevel || item.processingMethod))}}">
              <!-- 温度选项（冰/热/常温） -->
              <text wx:if="{{item.supportIce}}" class="spec-tag">冰</text>
              <text wx:if="{{item.supportHot}}" class="spec-tag">热</text>
              <text wx:if="{{item.supportNormal}}" class="spec-tag">常温</text>
              <!-- 咖啡类商品：烘焙度和处理法标签 -->
              <text wx:if="{{item.categoryId === 'coffee' && item.roastLevel}}" class="coffee-tag roast-tag">{{item.roastLevel}}</text>
              <text wx:if="{{item.categoryId === 'coffee' && item.processingMethod}}" class="coffee-tag process-tag">{{item.processingMethod}}</text>
            </view>

            <!-- 规格标签：拼球选项（冰淇淋） -->
            <view class="spec-tags" wx:elif="{{item.scoopOptions && item.scoopOptions.length > 0}}">
              <text wx:for="{{item.scoopOptions}}" wx:key="*this" class="spec-tag">{{item}}</text>
            </view>

            <!-- 底部：价格 + 加减号 -->
            <view class="product-card-footer">
              <text class="product-price">¥{{item.price}}</text>
              <view class="qty-control">
                <block wx:if="{{cartMap[item.id] > 0}}">
                  <view class="minus-btn" bindtap="onRemoveFromCart" data-id="{{item.id}}">
                    <view class="minus-line"></view>
                  </view>
                  <text class="qty-num">{{cartMap[item.id]}}</text>
                </block>
                <view class="add-btn" bindtap="onAddToCart" data-id="{{item.id}}" hover-class="btn-active" hover-stay-time="100">
                  <view class="icon-plus">
                    <view class="plus-h"></view>
                    <view class="plus-v"></view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      
      <!-- 加载中 -->
      <view wx:if="{{loading}}" class="empty-state">
        <text class="empty-text">加载中...</text>
      </view>

      <!-- 空状态提示 -->
      <view wx:elif="{{allProducts.length === 0}}" class="empty-state">
        <text class="empty-text">暂无商品</text>
      </view>

      <!-- 底部占位，距底部 20px -->
      <view class="product-list-spacer"></view>
    </scroll-view>
  </view>

</view>

<!-- 购物车悬浮按钮 -->
<view class="cart-fab" bindtap="onCartTap">
  <image src="/images/icons/cart.png" class="cart-fab-icon" mode="aspectFit"></image>
  <view wx:if="{{cartCount > 0}}" class="cart-fab-badge">
    <text class="cart-fab-badge-text">{{cartCount}}</text>
  </view>
</view>

<!-- 规格选择小浮窗 -->
<view wx:if="{{showSpecModal}}" class="spec-mask" catchtap="onCancelSpec"></view>
<view wx:if="{{showSpecModal}}" class="spec-popup">
  <view class="spec-popup-header">
    <text class="spec-popup-title">{{specModalProduct.name}}</text>
    <view class="spec-close-btn" bindtap="onCancelSpec" hover-class="spec-close-btn-active">
      <text class="spec-close-text">✕</text>
    </view>
  </view>

  <!-- 规格选项（有规格时才显示） -->
  <block wx:if="{{specModalType !== 'none'}}">
    <text class="spec-popup-subtitle">{{specModalType === 'temp' ? '请选择温度' : '请选择球数'}}</text>
    <view class="spec-options spec-options-row">
      <view
        wx:for="{{specOptions}}"
        wx:key="*this"
        class="spec-option spec-option-flex {{selectedSpec === item ? 'spec-option-active' : ''}}"
        bindtap="onSelectSpec"
        data-val="{{item}}"
      >
        <text class="spec-option-text {{selectedSpec === item ? 'spec-option-text-active' : ''}}">{{item}}</text>
      </view>
    </view>
  </block>

  <!-- 就餐方式（桌位模式锁定堂食，隐藏选择） -->
  <block wx:if="{{!tableMode}}">
    <text class="spec-popup-subtitle">请选择就餐方式</text>
    <view class="spec-options spec-options-row">
      <view
        class="spec-option spec-option-half {{selectedOrderType === 'dine-in' ? 'spec-option-active' : ''}}"
        bindtap="onSelectOrderType"
        data-val="dine-in"
      >
        <text class="spec-option-text {{selectedOrderType === 'dine-in' ? 'spec-option-text-active' : ''}}">堂食</text>
      </view>
      <view
        class="spec-option spec-option-half {{selectedOrderType === 'takeaway' ? 'spec-option-active' : ''}}"
        bindtap="onSelectOrderType"
        data-val="takeaway"
      >
        <text class="spec-option-text {{selectedOrderType === 'takeaway' ? 'spec-option-text-active' : ''}}">外带</text>
      </view>
    </view>
  </block>

  <view class="spec-actions">
    <view class="spec-cart-btn" bindtap="onConfirmSpec" hover-class="btn-active">
      <text class="spec-cart-text">{{tableMode ? '加入本桌' : '加入购物车'}}</text>
    </view>
    <view wx:if="{{!tableMode}}" class="spec-confirm-btn" bindtap="onBuyNow" hover-class="btn-active">
      <text class="spec-confirm-text">立即购买</text>
    </view>
  </view>
</view>
