<!-- staff.wxml -->
<!-- 根容器：任意点击解锁音频（小程序需用户交互后才能自动播放提示音） -->
<view class="staff-page" catchtap="onUnlockAudio">
<!-- 导航栏 -->
<view class="navbar" style="padding-top: {{statusBarHeight}}px; height: calc({{statusBarHeight}}px + 44px);">
  <view class="navbar-content">
    <view class="back-btn" bindtap="onBack">
      <text class="back-icon">←</text>
    </view>
    <view class="navbar-refresh-btn" bindtap="onRefresh">
      <text class="navbar-refresh-icon">↻</text>
    </view>
    <text class="navbar-title">店员点单窗口</text>
    <view class="staff-close-btn {{shopClosed ? 'close-active' : ''}}" bindtap="onToggleClosed">
      <text class="staff-close-text">{{shopClosed ? '打烊' : '营业'}}</text>
    </view>
  </view>
</view>

<!-- 占位空间，防止内容被导航栏遮挡 -->
<view class="navbar-placeholder" style="height: calc({{statusBarHeight}}px + 44px);"></view>

<!-- 声音未开启提示：点击一次即可解锁新订单提示音（平台要求首次播放需用户交互） -->
<view
  wx:if="{{!soundEnabled}}"
  class="sound-tip-banner"
  style="top: calc({{statusBarHeight}}px + 44px + 16px);"
  bindtap="onUnlockAudio"
>
  <text class="sound-tip-text">🔔 点击开启新订单提示音</text>
</view>

<view class="staff-container">
  <!-- 左栏：新订单（2/3） -->
  <view class="new-orders-section">

    <!-- 堂食+外带并排容器（横屏时水平排列） -->
    <view class="orders-body">
      <!-- 堂食订单区 -->
      <view class="order-type-section dine-section">
        <view class="type-header">
          <text class="type-title">堂食</text>
          <text class="type-count">({{dineInOrders.length}})</text>
        </view>
        <scroll-view class="order-list" scroll-y>
          <view wx:if="{{dineInOrders.length === 0}}" class="empty-tip">
            <text class="empty-text">暂无堂食订单</text>
          </view>
          <view
            wx:for="{{dineInOrders}}"
            wx:key="_id"
            class="order-card dine-card"
          >
            <!-- 订单头部 -->
            <view class="card-header">
              <view class="pickup-no-wrapper">
                <text class="pickup-no">{{item.pickupNumber}}</text>
              </view>
              <text wx:if="{{item.tableName}}" class="table-name-tag">🪑 {{item.tableName}}</text>
              <text class="order-time">{{item.time}}</text>
            </view>

            <!-- 商品明细 -->
            <view class="items-divider"></view>
            <view class="order-items">
              <view
                wx:for="{{item.items}}"
                wx:key="index"
                wx:for-item="product"
                class="item-row"
              >
                <view class="item-left">
                  <view class="item-title">
                    <text class="item-name">{{product.name}}</text>
                    <text class="item-temp" wx:if="{{product.temperature}}">
                      {{product.temperature}}
                    </text>
                    <text class="item-qty">x{{product.quantity}}</text>
                  </view>
                  <!-- 拼球：口味/加料分行显示 -->
                  <view wx:if="{{product.flavors}}" class="scoop-lines">
                    <view wx:for="{{product.flavors}}" wx:for-item="flavor" wx:key="index" class="scoop-line">
                      <text class="scoop-name">{{flavor.name}}</text>
                      <text class="scoop-qty">×{{flavor.qty}}</text>
                    </view>
                    <view wx:for="{{product.toppings}}" wx:for-item="topping" wx:key="index" class="scoop-line">
                      <text class="scoop-topping">{{topping}}</text>
                    </view>
                  </view>
                  <text wx:elif="{{product.spec}}" class="item-temp">{{product.spec}}</text>
                </view>
                <text class="item-price">¥{{product.price}}</text>
              </view>
            </view>
            
            <!-- 备注 -->
            <view wx:if="{{item.remark}}" class="order-remark">
              <text class="remark-label">备注：</text>
              <text class="remark-text">{{item.remark}}</text>
            </view>

            <!-- 完成按钮 -->
            <view class="card-divider"></view>
            <view
              class="complete-btn-wrapper"
              bindtap="onCompleteOrder"
              data-id="{{item._id}}"
            >
              <text class="complete-btn-text">完成</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 外带订单区 -->
      <view class="order-type-section takeaway-section">
        <view class="type-header">
          <text class="type-title">外带</text>
          <text class="type-count">({{takeawayOrders.length}})</text>
        </view>
        <scroll-view class="order-list" scroll-y>
          <view wx:if="{{takeawayOrders.length === 0}}" class="empty-tip">
            <text class="empty-text">暂无外带订单</text>
          </view>
          <view 
            wx:for="{{takeawayOrders}}" 
            wx:key="_id" 
            class="order-card takeaway-card"
          >
            <!-- 订单头部 -->
            <view class="card-header">
              <view class="pickup-no-wrapper">
                <text class="pickup-no">{{item.pickupNumber}}</text>
              </view>
              <text wx:if="{{item.tableName}}" class="table-name-tag">🪑 {{item.tableName}}</text>
              <text class="order-time">{{item.time}}</text>
            </view>

            <!-- 商品明细 -->
            <view class="items-divider"></view>
            <view class="order-items">
              <view
                wx:for="{{item.items}}"
                wx:key="index"
                wx:for-item="product"
                class="item-row"
              >
                <view class="item-left">
                  <view class="item-title">
                    <text class="item-name">{{product.name}}</text>
                    <text class="item-temp" wx:if="{{product.temperature}}">
                      {{product.temperature}}
                    </text>
                    <text class="item-qty">x{{product.quantity}}</text>
                  </view>
                  <!-- 拼球：口味/加料分行显示 -->
                  <view wx:if="{{product.flavors}}" class="scoop-lines">
                    <view wx:for="{{product.flavors}}" wx:for-item="flavor" wx:key="index" class="scoop-line">
                      <text class="scoop-name">{{flavor.name}}</text>
                      <text class="scoop-qty">×{{flavor.qty}}</text>
                    </view>
                    <view wx:for="{{product.toppings}}" wx:for-item="topping" wx:key="index" class="scoop-line">
                      <text class="scoop-topping">{{topping}}</text>
                    </view>
                  </view>
                  <text wx:elif="{{product.spec}}" class="item-temp">{{product.spec}}</text>
                </view>
                <text class="item-price">¥{{product.price}}</text>
              </view>
            </view>

            <!-- 备注 -->
            <view wx:if="{{item.remark}}" class="order-remark">
              <text class="remark-label">备注：</text>
              <text class="remark-text">{{item.remark}}</text>
            </view>

            <!-- 完成按钮 -->
            <view class="card-divider"></view>
            <view
              class="complete-btn-wrapper"
              bindtap="onCompleteOrder"
              data-id="{{item._id}}"
            >
              <text class="complete-btn-text">完成</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 右栏：已完成（1/3） -->
  <view class="completed-orders-section">
    <view class="section-header">
      <text class="section-title">已完成</text>
      <text class="section-count">({{completedOrders.length}})</text>
    </view>
    <scroll-view class="completed-list" scroll-y>
      <view wx:if="{{completedOrders.length === 0}}" class="empty-tip">
        <text class="empty-text">暂无已完成订单</text>
      </view>
      <view
        wx:for="{{completedOrders}}"
        wx:key="_id"
        class="completed-card"
      >
        <view class="completed-header">
          <text class="completed-pickup-no">{{item.pickupNumber}}</text>
          <text wx:if="{{item.tableName}}" class="table-name-tag">🪑 {{item.tableName}}</text>
          <text class="completed-type">
            {{item.orderType === 'dine-in' ? '堂食' : '外带'}}
          </text>
        </view>
        <!-- 商品明细 -->
        <view class="completed-items-divider"></view>
        <view class="completed-items">
          <view
            wx:for="{{item.items}}"
            wx:key="index"
            wx:for-item="product"
            class="completed-item-row"
          >
            <view class="completed-item-left">
              <view class="item-title">
                <text class="completed-item-name">{{product.name}}</text>
                <text class="completed-item-temp" wx:if="{{product.temperature}}">
                  {{product.temperature}}
                </text>
                <text class="completed-item-qty">x{{product.quantity}}</text>
              </view>
              <!-- 拼球：口味/加料分行显示 -->
              <view wx:if="{{product.flavors}}" class="scoop-lines">
                <view wx:for="{{product.flavors}}" wx:for-item="flavor" wx:key="index" class="scoop-line">
                  <text class="scoop-name">{{flavor.name}}</text>
                  <text class="scoop-qty">×{{flavor.qty}}</text>
                </view>
                <view wx:for="{{product.toppings}}" wx:for-item="topping" wx:key="index" class="scoop-line">
                  <text class="scoop-topping">{{topping}}</text>
                </view>
              </view>
              <text wx:elif="{{product.spec}}" class="completed-item-temp">{{product.spec}}</text>
            </view>
            <text wx:if="{{product.refunded}}" class="completed-item-refunded">已退款</text>
            <text wx:else class="completed-item-price">¥{{product.price}}</text>
          </view>
        </view>
        <view class="completed-info">
          <text class="completed-time">完成时间: {{item.completeTimeStr}}</text>
          <view class="completed-amount">
            <text wx:if="{{item.refundedAmount > 0}}" class="completed-refunded-amount">已退 ¥{{item.refundedAmount}}</text>
            <text class="completed-total">¥{{item.finalAmount}}</text>
          </view>
        </view>
        <view class="card-divider"></view>
        <view class="complete-btn-wrapper completed-refund-btn"
              bindtap="onOpenRefund" data-id="{{item._id}}">
          <text class="complete-btn-text">退款</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 桌位管理悬浮按钮（页面右下角） -->
<view class="staff-table-fab" bindtap="onOpenTableManage">
  <text class="staff-table-icon">🪑</text>
</view>

<!-- 退款选择弹窗 -->
<view wx:if="{{refundModal}}" class="refund-mask" bindtap="onCloseRefund">
  <view class="refund-modal" catchtap="noop">
    <view class="refund-modal-header">
      <text class="refund-modal-title">选择退款商品</text>
      <text class="refund-modal-close" bindtap="onCloseRefund">✕</text>
    </view>
    <scroll-view class="refund-modal-body" scroll-y>
      <view
        wx:for="{{refundModal.candidates}}"
        wx:key="index"
        wx:for-item="c"
        wx:for-index="idx"
        class="refund-candidate {{c.refunded ? 'refund-candidate-disabled' : ''}}"
        bindtap="onToggleRefundItem"
        data-index="{{idx}}"
      >
        <view class="refund-checkbox {{c.selected && !c.refunded ? 'refund-checkbox-on' : ''}}">
          <text wx:if="{{c.selected && !c.refunded}}" class="refund-checkbox-tick">✓</text>
        </view>
        <view class="refund-candidate-info">
          <text class="refund-candidate-name">{{c.name}}</text>
          <text wx:if="{{c.spec}}" class="refund-candidate-spec">{{c.spec}}</text>
        </view>
        <text wx:if="{{c.refunded}}" class="refund-candidate-refunded">已退款</text>
        <text wx:else class="refund-candidate-price">¥{{c.price}}</text>
      </view>
    </scroll-view>
    <view class="refund-modal-footer">
      <view class="refund-modal-actions">
        <text class="refund-select-all" bindtap="onSelectAllRefund">全选</text>
        <text class="refund-modal-amount">合计退款 ¥{{refundModal.selectedAmount}}</text>
      </view>
      <view class="refund-modal-btns">
        <view class="refund-btn-cancel" bindtap="onCloseRefund"><text>取消</text></view>
        <view class="refund-btn-confirm" bindtap="onConfirmRefund"><text>确认退款</text></view>
      </view>
    </view>
  </view>
</view>
</view>
