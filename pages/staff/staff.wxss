/* staff.wxss */

/* ========== 导航栏 ========== */
.navbar {
  width: 100%;
  background: white;
  border-bottom: 1.3rpx #E7DDD1 solid;
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
  box-sizing: border-box;
}

.navbar-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
}

.back-btn {
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #5B3A29;
  font-weight: bold;
}

.navbar-title {
  font-size: 40rpx;
  color: #5B3A29;
  font-family: 'CangerShuYuanTi', '仓耳舒圆体', Noto Serif SC, serif;
  font-weight: 500;
  line-height: 44px;
}

.navbar-refresh-btn {
  position: absolute;
  left: 122rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F9F5F0;
  border: 2rpx solid #C08A4D;
}

.navbar-refresh-icon {
  font-size: 32rpx;
  color: #C08A4D;
  font-weight: bold;
}

.navbar-placeholder {
  width: 100%;
}

/* ========== 主容器 ========== */
.staff-container {
  display: flex;
  height: 100vh;
  background: #f5f5f5;
}

/* ========== 左栏：新订单（2/3） ========== */
.new-orders-section {
  flex: 2;
  display: flex;
  flex-direction: column;
  border-right: 4rpx solid #e0e0e0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #e0e0e0;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3B1F0F;
  font-family: 'CangerShuYuanTi', '仓耳舒圆体', Noto Serif SC, serif;
}

.refresh-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f0f0;
}

.refresh-icon {
  font-size: 36rpx;
  color: #666666;
}

/* 新订单区域的堂食/外带容器 */
.orders-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 订单类型区域 */
.order-type-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.type-header {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  background: #fafafa;
  border-bottom: 2rpx solid #e0e0e0;
}

.type-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3B1F0F;
  margin-right: 10rpx;
  font-family: 'CangerShuYuanTi', '仓耳舒圆体', Noto Serif SC, serif;
}

.type-count {
  font-size: 28rpx;
  color: #999999;
}

/* 订单列表 */
.order-list {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  padding-bottom: calc(40rpx + 30px);
  box-sizing: border-box;
}

.empty-tip {
  padding: 100rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 订单卡片 */
.order-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 堂食订单：橙色左边框 */
.dine-card {
  border-left: 8rpx solid #FF6B35;
}

/* 外带订单：蓝色左边框 */
.takeaway-card {
  border-left: 8rpx solid #4A90E2;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.pickup-no-wrapper {
  display: flex;
  align-items: center;
}

.pickup-no {
  font-size: 64rpx;
  font-weight: bold;
  color: #FF6B35;
  letter-spacing: 4rpx;
}

.order-time {
  font-size: 28rpx;
  color: #999999;
}

.table-name-tag {
  font-size: 24rpx;
  color: #C08A4D;
  background: #FDF6EE;
  border: 1rpx solid #E8CC9A;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 线下支付标记（店员手动点单，不调微信支付） */
.offline-pay-tag {
  font-size: 22rpx;
  color: #0E7490;
  background: #E0F2FE;
  border: 1rpx solid #7DD3FC;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 商品明细 */
.items-divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

.order-items {
  margin-bottom: 20rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.item-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
}

.item-title {
  display: flex;
  align-items: center;
}

.item-name {
  font-size: 30rpx;
  color: #333333;
  margin-right: 15rpx;
}

.item-temp {
  font-size: 24rpx;
  color: #FF6B35;
  background: #FFF0E8;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 15rpx;
}

.item-qty {
  font-size: 24rpx;
  color: #999999;
}

.item-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #3B1F0F;
}

/* ========== 拼球口味分行显示 ========== */
.scoop-lines {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding-left: 20rpx;
}

.scoop-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.scoop-name {
  font-size: 20rpx;
  color: #666666;
  line-height: 1.4;
}

.scoop-qty {
  font-size: 18rpx;
  color: #999999;
  line-height: 1.4;
}

.scoop-topping {
  font-size: 20rpx;
  color: #999999;
  line-height: 1.4;
}

/* 备注 */
.order-remark {
  background: #FFF9E6;
  padding: 15rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.remark-label {
  font-size: 26rpx;
  color: #FF9800;
  margin-right: 10rpx;
}

.remark-text {
  font-size: 26rpx;
  color: #666666;
}

.card-divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

/* 完成按钮 */
.complete-btn-wrapper {
  width: 100%;
  height: 80rpx;
  background: #FF6B35;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.complete-btn-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}

.complete-btn-wrapper:active {
  background: #E55A2B;
  transform: scale(0.98);
}

/* 订单操作按钮行：编辑 / 删除 / 完成 */
.order-actions {
  display: flex;
  gap: 16rpx;
}
.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
}
.action-btn:active {
  transform: scale(0.98);
  opacity: 0.85;
}
.action-btn-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}
.action-btn-edit {
  background: #8B6F5E;
}
.action-btn-delete {
  background: #E5484D;
}
.action-btn-complete {
  background: #FF6B35;
}

/* ========== 右栏：已完成（1/3）- 灰色 ========== */
.completed-orders-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.section-count {
  font-size: 28rpx;
  color: #999999;
}

.completed-list {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  padding-bottom: calc(40rpx + 30px);
  box-sizing: border-box;
}

/* 已完成卡片 - 灰色 */
.completed-card {
  background: #e0e0e0;
  opacity: 0.7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
  border-left: 6rpx solid #999999;
}

.completed-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.completed-pickup-no {
  font-size: 48rpx;
  font-weight: bold;
  color: #999999;
}

.completed-pickup-wrap {
  display: flex;
  align-items: center;
}

.completed-type {
  font-size: 24rpx;
  color: #666666;
  background: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* 已完成订单商品明细 */
.completed-items-divider {
  height: 2rpx;
  background: #cccccc;
  margin: 10rpx 0;
}

.completed-items {
  margin-bottom: 10rpx;
}

.completed-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.completed-item-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
}

.completed-item-name {
  font-size: 26rpx;
  color: #666666;
  margin-right: 10rpx;
}

.completed-item-temp {
  font-size: 22rpx;
  color: #999999;
  background: #e0e0e0;
  padding: 3rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}

.completed-item-qty {
  font-size: 22rpx;
  color: #999999;
}

.completed-item-price {
  font-size: 26rpx;
  color: #666666;
}

.completed-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.completed-time {
  font-size: 24rpx;
  color: #666666;
}

.completed-total {
  font-size: 28rpx;
  font-weight: bold;
  color: #666666;
}

/* 已完成卡片：最终金额 + 已退提示 */
.completed-amount {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.completed-refunded-amount {
  font-size: 22rpx;
  color: #E5484D;
}

.completed-item-refunded {
  font-size: 22rpx;
  color: #E5484D;
  background: #ffffff;
  padding: 3rpx 8rpx;
  border-radius: 4rpx;
}

/* 已完成卡片：退款按钮（复用完成按钮结构，红色区分） */
.completed-refund-btn {
  background: #E5484D;
}

.completed-refund-btn:active {
  background: #C63B40;
}

/* ===== 退款选择弹窗 ===== */
.refund-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.refund-modal {
  width: 600rpx;
  max-width: 480px;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.refund-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.refund-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.refund-modal-close {
  font-size: 32rpx;
  color: #999999;
  padding: 0 8rpx;
}

.refund-modal-body {
  height: 400rpx;
  max-height: 50vh;
  padding: 10rpx 30rpx;
  box-sizing: border-box;
}

.refund-candidate {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.refund-candidate-disabled {
  opacity: 0.5;
}

.refund-checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #cccccc;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refund-checkbox-on {
  background: #FF6B35;
  border-color: #FF6B35;
}

.refund-checkbox-tick {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: bold;
  line-height: 1;
}

.refund-candidate-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.refund-candidate-name {
  font-size: 28rpx;
  color: #333333;
}

.refund-candidate-spec {
  font-size: 22rpx;
  color: #999999;
}

.refund-candidate-price {
  font-size: 28rpx;
  color: #333333;
}

.refund-candidate-refunded {
  font-size: 24rpx;
  color: #E5484D;
}

.refund-modal-footer {
  padding: 20rpx 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.refund-modal-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.refund-select-all {
  font-size: 28rpx;
  color: #FF6B35;
}

.refund-modal-amount {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}

.refund-modal-btns {
  display: flex;
  gap: 20rpx;
}

.refund-btn-cancel,
.refund-btn-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.refund-btn-cancel {
  background: #f0f0f0;
  color: #666666;
}

.refund-btn-confirm {
  background: #FF6B35;
  color: #ffffff;
  font-weight: bold;
}

/* ===== iPad 横屏适配（所有尺寸用 px，避免 rpx 随宽屏放大） ===== */
@media (orientation: landscape) and (min-width: 600px) {

  /* 导航栏 */
  .navbar {
    border-bottom: 1px solid #E7DDD1;
  }

  .navbar-content {
    height: 44px;
    width: 100%;
  }

  .back-btn {
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
  }

  .back-icon {
    font-size: 24px;
  }

  .navbar-title {
    font-size: 18px;
    line-height: 44px;
    font-family: 'CangerShuYuanTi', '仓耳舒圆体', Noto Serif SC, serif;
  }

  .staff-container {
    height: 100vh;
  }

  /* 左栏比例更大 */
  .new-orders-section {
    flex: 3;
    border-right: 2px solid #e0e0e0;
  }

  /* section 标题栏 */
  .section-header {
    padding: 10px 16px;
  }

  .section-title {
    font-size: 14px;
    font-family: 'CangerShuYuanTi', '仓耳舒圆体', Noto Serif SC, serif;
  }

  .refresh-btn {
    width: 28px;
    height: 28px;
  }

  .refresh-icon {
    font-size: 16px;
  }

  .navbar-refresh-btn {
    width: 28px;
    height: 28px;
    left: 61px;
    border-width: 1px;
  }

  .navbar-refresh-icon {
    font-size: 16px;
  }

  .staff-order-btn {
    left: 139px; /* 刷新图标（61px + 28px）后 50px，避开右上角胶囊按钮 */
  }

  /* 堂食/外带改为左右并排 */
  .orders-body {
    flex-direction: row;
  }

  .order-type-section {
    border-right: 1px solid #e0e0e0;
  }

  .order-type-section:last-child {
    border-right: none;
  }

  /* 类型标题栏 */
  .type-header {
    padding: 10px 16px;
  }

  .type-title {
    font-size: 14px;
    margin-right: 4px;
    font-family: 'CangerShuYuanTi', '仓耳舒圆体', Noto Serif SC, serif;
  }

  .type-count {
    font-size: 12px;
  }

  /* 订单列表内边距 */
  .order-list {
    padding: 8px;
    padding-bottom: 50px;
    height: 100%;
    box-sizing: border-box;
  }

  /* 订单卡片 */
  .order-card {
    padding: 10px 12px;
    margin-bottom: 8px;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.07);
  }

  .dine-card {
    border-left: 4px solid #FF6B35;
  }

  .takeaway-card {
    border-left: 4px solid #4A90E2;
  }

  .card-header {
    margin-bottom: 8px;
  }

  /* 取号大字 */
  .pickup-no {
    font-size: 28px;
    letter-spacing: 1px;
  }

  .table-name-tag {
    font-size: 28px;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .offline-pay-tag {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .order-time {
    font-size: 11px;
  }

  /* 商品明细 */
  .items-divider {
    margin: 6px 0;
  }

  .order-items {
    margin-bottom: 6px;
  }

  .item-row {
    padding: 5px 0;
  }

  .item-name {
    font-size: 13px;
    margin-right: 6px;
  }

  .item-temp {
    font-size: 11px;
    padding: 2px 5px;
    margin-right: 6px;
  }

  .item-qty {
    font-size: 11px;
  }

  .scoop-lines {
    padding-left: 10px;
  }

  .scoop-name {
    font-size: 10px;
  }

  .scoop-qty {
    font-size: 9px;
  }

  .scoop-topping {
    font-size: 10px;
  }

  .item-price {
    font-size: 13px;
  }

  /* 备注 */
  .order-remark {
    padding: 6px 8px;
    margin-bottom: 6px;
  }

  .remark-label,
  .remark-text {
    font-size: 11px;
  }

  .card-divider {
    margin: 6px 0;
  }

  /* 完成按钮 */
  .complete-btn-wrapper {
    height: 44px;
    border-radius: 6px;
    position: relative;
    z-index: 10;
  }

  .complete-btn-wrapper::after {
    content: '';
    position: absolute;
    top: -10px;
    left: -10px;
    right: -10px;
    bottom: -10px;
  }

  .complete-btn-text {
    font-size: 15px;
    font-weight: bold;
    position: relative;
    z-index: 1;
  }

  /* 订单操作按钮行（横屏） */
  .order-actions {
    gap: 8px;
  }
  .action-btn {
    height: 44px;
    border-radius: 6px;
  }
  .action-btn-text {
    font-size: 14px;
  }

  /* 已完成栏固定宽度 */
  .completed-orders-section {
    flex: 0 0 200px;
    min-width: 200px;
  }

  .completed-list {
    padding: 8px;
    padding-bottom: 50px;
    height: 100%;
    box-sizing: border-box;
  }

  .completed-card {
    padding: 8px 10px;
    margin-bottom: 8px;
    border-radius: 6px;
    border-left: 3px solid #999999;
  }

  .completed-pickup-no {
    font-size: 22px;
  }

  .completed-type {
    font-size: 11px;
    padding: 2px 6px;
  }

  .completed-header .table-name-tag {
    font-size: 11px;
    padding: 2px 6px;
  }

  .completed-items-divider {
    margin: 6px 0;
  }

  .completed-items {
    margin-bottom: 6px;
  }

  .completed-item-row {
    padding: 4px 0;
  }

  .completed-item-name {
    font-size: 11px;
    margin-right: 4px;
  }

  .completed-item-temp {
    font-size: 10px;
    padding: 1px 4px;
    margin-right: 4px;
  }

  .completed-item-qty {
    font-size: 10px;
  }

  .completed-item-price {
    font-size: 11px;
  }

  .completed-time {
    font-size: 11px;
  }

  .completed-total {
    font-size: 12px;
  }

  .section-count {
    font-size: 12px;
  }

  .empty-tip {
    padding: 40px 0;
  }

  .empty-text {
    font-size: 12px;
  }

  /* 退款弹窗：固定 px，避免 rpx 随 iPad 宽屏放大导致比例过大 */
  .refund-modal {
    width: 480px;
    max-height: 70vh;
  }
  .refund-modal-header {
    padding: 16px 20px;
  }
  .refund-modal-title {
    font-size: 17px;
  }
  .refund-modal-close {
    font-size: 17px;
  }
  .refund-modal-body {
    height: 320px;
    max-height: 50vh;
    padding: 8px 20px;
  }
  .refund-candidate {
    padding: 12px 0;
  }
  .refund-checkbox {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    margin-right: 14px;
  }
  .refund-checkbox-tick {
    font-size: 18px;
  }
  .refund-candidate-name {
    font-size: 15px;
  }
  .refund-candidate-spec {
    font-size: 12px;
  }
  .refund-candidate-price {
    font-size: 15px;
  }
  .refund-candidate-refunded {
    font-size: 13px;
  }
  .refund-modal-footer {
    padding: 16px 20px;
  }
  .refund-modal-actions {
    margin-bottom: 12px;
  }
  .refund-select-all {
    font-size: 15px;
  }
  .refund-modal-amount {
    font-size: 15px;
  }
  .refund-btn-cancel,
  .refund-btn-confirm {
    height: 44px;
    border-radius: 8px;
    font-size: 15px;
  }
}

.staff-close-btn {
  padding: 4px 14px;
  border-radius: 14px;
  background: rgba(46,125,50,0.15);
}
.staff-close-btn.close-active { background: rgba(198,40,40,0.15); }
.staff-close-text { font-size: 13px; color: #2E7D32; font-weight: 500; }
.close-active .staff-close-text { color: #C62828; }

/* 桌位管理悬浮按钮（页面右下角，半透明；固定 px，横竖屏一致） */
.staff-table-fab {
  position: fixed;
  right: 24px;
  bottom: calc(24px + env(safe-area-inset-bottom));
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  border: 2px solid rgba(192, 138, 77, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  z-index: 200;
}
.staff-table-fab:active {
  background: rgba(255, 255, 255, 0.9);
  transform: scale(0.96);
}
.staff-table-icon {
  font-size: 32px;
  line-height: 1;
}

/* 声音解锁提示横幅 */
.sound-tip-banner {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 95;
  padding: 14px 28px;
  background: #FFF3E0;
  border: 2px solid #FF9800;
  border-radius: 40px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
}
.sound-tip-banner:active {
  background: #FFE0B2;
}
.sound-tip-text {
  font-size: 30rpx;
  color: #E65100;
  font-weight: 600;
}

/* 手动点单入口按钮（导航栏右侧，固定 px） */
.staff-order-btn {
  position: absolute;
  left: 228rpx; /* 刷新图标（122rpx + 56rpx）后 50rpx，避开右上角胶囊按钮 */
  top: 50%;
  transform: translateY(-50%);
  padding: 4px 14px;
  border-radius: 14px;
  background: rgba(163, 33, 45, 0.12);
}
.staff-order-btn:active { background: rgba(163, 33, 45, 0.22); }
.staff-order-text { font-size: 13px; color: #A3212D; font-weight: 600; }

/* 手动点单侧栏遮罩（在侧栏之下、页面内容之上） */
.order-sidebar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1999;
}

