/* tableManage.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F9F5F0;
}

/* ========== 导航栏 ========== */
.navbar {
  width: 100%;
  background: white;
  border-bottom: 1.3rpx #E7DDD1 solid;
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
  box-sizing: border-box;
}

.navbar-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
}

.back-btn {
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #5B3A29;
  font-weight: bold;
}

.navbar-title {
  font-size: 40rpx;
  color: #5B3A29;
  font-family: 'CangerShuYuanTi', '仓耳舒圆体', Noto Serif SC, serif;
  font-weight: 500;
  line-height: 44px;
}

.navbar-placeholder {
  width: 100%;
}

/* ========== 主体 ========== */
.page-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty-tip {
  padding: 120rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.table-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.table-item {
  width: 31%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E7DDD1;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.table-item.selected {
  border-color: #A3212D;
  background: rgba(163, 33, 45, 0.05);
}

.table-item.disabled {
  opacity: 0.55;
}

.table-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #3A2318;
  font-family: 'CangerShuYuanTi', '仓耳舒圆体', Noto Serif SC, serif;
}

.table-status {
  font-size: 22rpx;
  font-weight: 500;
  margin-top: 12rpx;
}

.status-open {
  color: #2E7D32;
}

.status-off {
  color: #C62828;
}

/* ========== 底部操作栏 ========== */
.bottom-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #E7DDD1;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-btn {
  background: #FFF5F5;
  border: 2rpx solid #A3212D;
}

.disable-btn {
  background: #A3212D;
}

.restore-btn {
  background: #2E7D32;
}

.action-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #A3212D;
  font-family: 'CangerShuYuanTi', '仓耳舒圆体', Noto Serif SC, serif;
}

.disable-btn .action-text,
.restore-btn .action-text {
  color: #FFFFFF;
}

/* ===== iPad 横屏适配（px 固定，避免 rpx 随宽屏放大） ===== */
@media (orientation: landscape) and (min-width: 600px) {
  .navbar {
    border-bottom: 1px solid #E7DDD1;
  }

  .navbar-title {
    font-size: 18px;
  }

  .back-btn {
    left: 12px;
    width: 32px;
    height: 32px;
  }

  .back-icon {
    font-size: 24px;
  }

  .page-body {
    padding: 16px;
  }

  .table-item {
    width: 31%;
    margin-bottom: 16px;
    padding: 12px 10px;
    border-width: 1px;
    border-radius: 10px;
  }

  .table-name {
    font-size: 16px;
  }

  .table-status {
    font-size: 12px;
    margin-top: 6px;
  }

  .bottom-actions {
    gap: 12px;
    padding: 12px 16px;
    padding-bottom: calc(12px + env(safe-area-inset-bottom));
    border-top-width: 1px;
  }

  .action-btn {
    height: 48px;
    border-radius: 24px;
  }

  .clear-btn {
    border-width: 1px;
  }

  .action-text {
    font-size: 15px;
  }
}
